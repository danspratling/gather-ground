---
import { cn } from '@/lib/utils';
import type { ProductCardProps } from '@/types/productCard';

type Props = ProductCardProps;

const {
  variant,
  image,
  imageAlt,
  title,
  description,
  href,
  class: className,
} = Astro.props;
---

{
  variant === 'category' ? (
    <article class={cn('rounded-xl bg-secondary-50 overflow-hidden', className)}>
      <a href={href} class="group flex flex-col gap-4">
        <div class="overflow-hidden">
          <img
            src={image}
            alt={imageAlt}
            class="h-48 w-full object-cover transition-transform duration-300 group-hover:scale-105 group-focus:scale-105"
          />
        </div>
        <div class="flex flex-col gap-2 p-6 pt-0">
          <h3 class="text-lg font-semibold text-gray-900 group-hover:underline group-focus:underline">
            {title}
          </h3>
          {description && (
            <p class="text-sm font-normal text-gray-600">{description}</p>
          )}
        </div>
      </a>
    </article>
  ) : (
    <article class={cn('relative overflow-hidden rounded-xl', className)}>
      <a href={href} class="group block">
        <img
          src={image}
          alt={imageAlt}
          class="h-64 w-full object-cover transition-transform duration-300 group-hover:scale-105"
        />
        <div class="absolute inset-0 flex items-end bg-gradient-to-t from-black/60 to-transparent p-6">
          <h3 class="text-xl font-semibold text-off-white">{title}</h3>
        </div>
      </a>
    </article>
  )
}
