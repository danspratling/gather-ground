---
import { sanityImageSrc, sanityImageAlt } from '@/lib/sanityImage';

interface SanityImage {
  _type?: 'image';
  asset?: { _ref: string };
  alt?: string;
  caption?: string;
}

interface Props {
  node: SanityImage;
}

const { node } = Astro.props;
const src = sanityImageSrc(node);
const alt = sanityImageAlt(node, '');
---

{
  src && (
    <figure class="my-8">
      <img src={src} alt={alt} loading="lazy" class="w-full rounded-lg" />
      {node.caption && (
        <figcaption class="text-secondary mt-2 text-sm">
          {node.caption}
        </figcaption>
      )}
    </figure>
  )
}
