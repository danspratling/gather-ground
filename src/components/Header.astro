---
import NavMenu from '@/components/NavMenu';
import MobileMenu from '@/components/MobileMenu';
import type { HeaderProps } from '@/components/Header.types';

type Props = HeaderProps;

const {
  logoSrc,
  logoAlt,
  navLinks,
  ctaLabel = 'Order now',
  ctaHref = '/shop',
} = Astro.props;
---

<header class="sticky top-0 z-40 w-full border-b border-gray-100 bg-off-white">
  <div
    class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3 md:px-8"
  >
    <a href="/" class="shrink-0" aria-label="Gather Ground home">
      <img src={logoSrc} alt={logoAlt} class="h-8 w-auto" />
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label="Main navigation">
      {
        navLinks.map((link) =>
          link.menu ? (
            <NavMenu client:visible label={link.label} items={link.menu} />
          ) : (
            <a
              href={link.href}
              class="rounded-[6px] px-2 py-0.5 text-sm font-medium text-brand-700 hover:text-brand-900"
            >
              {link.label}
            </a>
          )
        )
      }
    </nav>

    <div class="flex items-center gap-3">
      <a
        href={ctaHref}
        class="hidden rounded-lg bg-brand-800 px-4 py-2 text-sm font-semibold text-white hover:bg-brand-900 md:inline-flex"
      >
        {ctaLabel}
      </a>
      <div class="md:hidden">
        <MobileMenu
          client:visible
          navLinks={navLinks}
          ctaLabel={ctaLabel}
          ctaHref={ctaHref}
        />
      </div>
    </div>
  </div>
</header>
