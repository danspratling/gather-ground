---
import { LinkExternal02 } from '@untitledui-pro/icons/line';
import type { InstagramFeedSectionProps } from './InstagramFeedSection.types';

type Props = InstagramFeedSectionProps;

const {
  eyebrow,
  heading,
  subCopy,
  viewAllLabel = 'Follow on Instagram',
  handle,
  feedId,
} = Astro.props;

const profileUrl = handle
  ? `https://www.instagram.com/${handle.replace(/^@/, '')}/`
  : undefined;
---

<section class="py-12 lg:py-24">
  <div class="container flex flex-col gap-12">
    <div
      class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between"
    >
      <div class="flex flex-col gap-3">
        {
          eyebrow && (
            <p class="text-sm font-semibold text-brand-700">{eyebrow}</p>
          )
        }
        <h2
          class="text-display-md font-semibold tracking-display-md text-gray-900"
        >
          {heading}
        </h2>
        {subCopy && <p class="text-base text-gray-600">{subCopy}</p>}
      </div>
      {
        profileUrl && (
          <div class="shrink-0">
            <a
              href={profileUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex cursor-pointer items-center justify-center gap-2 whitespace-nowrap rounded-full border border-brand-600 bg-brand-700 px-3.5 py-2.5 text-sm font-semibold text-brand-25 transition-colors hover:bg-brand-600 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"
            >
              {viewAllLabel}
              <LinkExternal02 class="size-4" aria-hidden="true" />
            </a>
          </div>
        )
      }
    </div>

    {feedId && <behold-widget feed-id={feedId} />}
  </div>
</section>
