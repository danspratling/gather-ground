---
import type { SbBlokData } from '@storyblok/astro';
import TestimonialsSection from './TestimonialsSection';

interface Props {
  blok: SbBlokData;
}

const { blok } = Astro.props;

interface ResolvedTestimonial {
  content: {
    quote: string;
    platform?: string;
    author_src?: { filename: string; alt: string };
    author_name: string;
    author_secondary?: string;
    author_secondary_is_handle?: boolean;
  };
}

const testimonials = (blok.testimonials as ResolvedTestimonial[]).map((t) => ({
  quote: t.content.quote,
  platform: t.content.platform || undefined,
  author: {
    src: t.content.author_src?.filename ?? '',
    alt: t.content.author_src?.alt ?? '',
    name: t.content.author_name,
    secondary: t.content.author_secondary || undefined,
    secondaryIsHandle: t.content.author_secondary_is_handle ?? false,
    size: 'md' as const,
  },
}));
---

<TestimonialsSection
  client:visible
  heading={blok.heading as string}
  subCopy={blok.sub_copy as string}
  testimonials={testimonials}
/>
