---
import type { ContentAlternatingProps } from './Content.types';
import * as icons from '@untitledui-pro/icons/line';
import { CheckCircle } from '@untitledui-pro/icons/line';

type Props = Omit<ContentAlternatingProps, 'variant'>;

const {
  icon,
  heading,
  body,
  checklistItems: rawChecklistItems = [],
  image,
  imagePosition = 'right',
  dark = false,
} = Astro.props;

const checklistItems = Array.isArray(rawChecklistItems)
  ? rawChecklistItems
  : typeof rawChecklistItems === 'string'
    ? rawChecklistItems
        .split('\n')
        .map((item) => item.trim())
        .filter(Boolean)
    : [];

const IconComponent = icon ? icons[icon as keyof typeof icons] : null;
---

<section class:list={[dark ? 'bg-brand-900' : 'bg-off-white', 'py-24']}>
  <div
    class:list={[
      'container flex flex-col lg:flex-row gap-16 items-center',
      imagePosition === 'left' ? 'lg:flex-row-reverse' : '',
    ]}
  >
    <!-- Content column -->
    <div class="flex flex-col gap-5 flex-1 min-w-0">
      <div class="flex flex-col gap-6 items-start">
        {
          IconComponent && (
            <div
              class:list={[
                'flex items-center justify-center rounded-[10px] size-14',
                dark ? 'bg-brand-600' : 'bg-brand-50',
              ]}
            >
              <IconComponent
                className={
                  dark ? 'size-7 text-brand-50' : 'size-7 text-brand-600'
                }
                aria-hidden="true"
              />
            </div>
          )
        }
        <h2
          class:list={[
            'text-display-md font-semibold tracking-display-md',
            dark ? 'text-off-white' : 'text-brand-900',
          ]}
        >
          {heading}
        </h2>
      </div>
      <p
        class:list={[
          'text-xl font-normal',
          dark ? 'text-brand-200' : 'text-brand-400',
        ]}
      >
        {body}
      </p>
      {
        checklistItems.length > 0 && (
          <ul class="flex flex-col gap-4 mt-3">
            {checklistItems.map((item) => (
              <li class="flex items-start gap-3">
                <CheckCircle
                  className={
                    dark
                      ? 'size-6 shrink-0 mt-0.5 text-brand-300'
                      : 'size-6 shrink-0 mt-0.5 text-brand-600'
                  }
                  aria-hidden="true"
                />
                <span
                  class:list={[
                    'text-md font-normal',
                    dark ? 'text-brand-300' : 'text-brand-600',
                  ]}
                >
                  {item}
                </span>
              </li>
            ))}
          </ul>
        )
      }
    </div>

    <!-- Image column -->
    <div class="flex-1 min-w-0 w-full lg:w-auto">
      <img
        src={image.src}
        alt={image.alt}
        class="w-full rounded-2xl object-cover aspect-4/3 lg:aspect-auto lg:h-full"
        width={800}
        height={600}
        loading="lazy"
        decoding="async"
      />
    </div>
  </div>
</section>
