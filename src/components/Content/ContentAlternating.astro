---
import type { ContentAlternatingProps } from './Content.types';
import ContentAlternatingInlineSeparated from './ContentAlternatingInlineSeparated.astro';
import ContentAlternatingInlineOverlapping from './ContentAlternatingInlineOverlapping.astro';
import ContentAlternatingFullBleed from './ContentAlternatingFullBleed.astro';

type Props = Omit<ContentAlternatingProps, 'variant'>;

const { imageLayout = 'inline-separated', ...rest } = Astro.props;

const layoutMap = {
  'inline-separated': ContentAlternatingInlineSeparated,
  'inline-overlapping': ContentAlternatingInlineOverlapping,
  'full-bleed': ContentAlternatingFullBleed,
} as const;

const Layout = layoutMap[imageLayout];
---

<Layout {...rest} />
