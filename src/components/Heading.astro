---
import { cn } from '@/lib/utils';
import type { HeadingProps } from '@/components/Heading.types';

type Props = HeadingProps;

const {
  as: Tag = 'h2',
  size = 'display-md',
  weight = 'semibold',
  color,
  text,
  class: className,
} = Astro.props;

const sizeClasses = {
  'display-xl': 'text-display-xl tracking-display-xl',
  'display-md': 'text-display-md tracking-display-md',
  'text-xl': 'text-xl',
  'text-lg': 'text-lg',
};

const weightClasses = {
  medium: 'font-medium',
  semibold: 'font-semibold',
};

const classes = cn(sizeClasses[size], weightClasses[weight], className);
---

<Tag class={classes} style={color ? `color: ${color}` : undefined}>
  {text ?? <slot />}
</Tag>
