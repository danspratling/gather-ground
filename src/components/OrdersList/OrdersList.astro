---
import type { OrdersListProps } from './OrdersList.types';
import OrderListItem from '@/components/OrderListItem/OrderListItem.astro';

type Props = OrdersListProps;
const { orders } = Astro.props;
---

{
  orders.length === 0 ? (
    <div class="rounded-lg border border-gray-200 bg-white py-12 text-center">
      <p class="text-sm font-medium text-brand-900">No orders yet</p>
      <p class="mt-1 text-sm text-gray-800">
        Your order history will appear here once you've placed an order.
      </p>
    </div>
  ) : (
    <div class="flex flex-col gap-3">
      {orders.map((order) => (
        <OrderListItem {...order} />
      ))}
    </div>
  )
}
