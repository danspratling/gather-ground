---
import type { OrderListItemProps } from './OrderListItem.types';
import OrderStatusBadge from '@/components/OrderStatusBadge/OrderStatusBadge.astro';

type Props = OrderListItemProps;
const { id, orderNumber, placedAt, status, itemCount, totalFormatted } =
  Astro.props;

const formattedDate = new Date(placedAt).toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
});
---

<a
  href={`/account/orders/${id}`}
  class="flex items-center justify-between gap-4 rounded-lg border border-gray-200 bg-white p-4 transition-colors hover:bg-gray-50"
>
  <div class="flex min-w-0 flex-col gap-1">
    <span class="text-sm font-semibold text-brand-900">{orderNumber}</span>
    <span class="text-xs text-gray-800">{formattedDate}</span>
  </div>

  <div class="hidden sm:block">
    <OrderStatusBadge status={status} />
  </div>

  <div class="flex flex-col items-end gap-1 text-right">
    <span class="text-sm font-semibold text-brand-900">{totalFormatted}</span>
    <span class="text-xs text-gray-800">
      {itemCount}
      {itemCount === 1 ? 'item' : 'items'}
    </span>
  </div>
</a>
