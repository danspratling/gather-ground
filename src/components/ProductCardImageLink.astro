---
import { cn } from '@/lib/utils';
import type { ProductCardProps } from '@/components/ProductCard.types';

type Props = Omit<ProductCardProps, 'variant'>;

const { image, imageAlt, title, href, class: className } = Astro.props;
---

<article class={cn('relative overflow-hidden rounded-xl', className)}>
  <a href={href} class="group block">
    <img
      src={image}
      alt={imageAlt}
      class="h-64 w-full object-cover transition-transform duration-300 group-hover:scale-105"
    />
    <div
      class="absolute inset-0 flex items-end bg-gradient-to-t from-black/60 to-transparent p-6"
    >
      <h3 class="text-xl font-semibold text-off-white">{title}</h3>
    </div>
  </a>
</article>
