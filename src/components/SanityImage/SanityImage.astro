---
import { stegaClean } from '@sanity/client/stega';
import { sanityImageUrl } from '@/lib/sanityImage';
import type { SanityImageProps } from './SanityImage.types';

type Props = SanityImageProps;

const {
  asset,
  alt,
  width = 800,
  height,
  quality = 80,
  class: className,
} = Astro.props;

const cleaned = stegaClean(asset) as typeof asset;
const id = cleaned?.asset?._ref ?? cleaned?.asset?._id;

let src = '';
if (id) {
  let urlBuilder = sanityImageUrl(cleaned)
    .width(width)
    .quality(quality)
    .auto('format');
  if (height) urlBuilder = urlBuilder.height(height);
  src = urlBuilder.url();
}
---

{
  src && (
    <img
      src={src}
      alt={alt}
      width={width}
      height={height}
      loading="lazy"
      decoding="async"
      class={className}
    />
  )
}
