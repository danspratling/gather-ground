---
import type { CtaSimpleLeftProps } from './CtaSimpleLeft.types';
import Button from '@/components/Forms/Button/Button.astro';

type Props = CtaSimpleLeftProps;

const { heading, body, primaryCta, secondaryCta } = Astro.props;
---

<section class="py-16">
  <div
    class="container flex flex-col md:flex-row md:items-center md:justify-between gap-8"
  >
    <div class="flex flex-col gap-2">
      <h2
        class="text-display-sm font-semibold tracking-display-sm text-brand-900"
      >
        {heading}
      </h2>
      <p class="text-xl font-normal text-gray-600">
        {body}
      </p>
    </div>
    <div
      class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 shrink-0"
    >
      {
        secondaryCta && (
          <Button
            label={secondaryCta.label}
            href={secondaryCta.href}
            variant="outline"
          />
        )
      }
      <Button
        label={primaryCta.label}
        href={primaryCta.href}
        variant="default"
      />
    </div>
  </div>
</section>
