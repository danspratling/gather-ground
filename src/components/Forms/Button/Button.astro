---
import { cn } from '@/lib/utils';
import type { ButtonProps } from '@/components/Forms/Button/Button.types';

type Props = ButtonProps;

const {
  label,
  href,
  variant = 'default',
  size = 'md',
  type = 'button',
  disabled = false,
  loading = false,
  iconOnly = false,
  class: className,
  ...rest
} = Astro.props;

const isDisabled = disabled || loading;
const hasLeadingIcon = Astro.slots.has('icon-leading');
const hasTrailingIcon = Astro.slots.has('icon-trailing');

const variantClasses = {
  default:
    'bg-brand-700 border-2 border-brand-600 text-brand-25 hover:bg-brand-600 disabled:bg-gray-100 disabled:border-0 disabled:text-gray-400',
  outline: 'bg-background border border-border text-foreground hover:bg-muted',
  ghost: 'bg-transparent text-foreground hover:bg-muted',
  link: 'text-foreground underline-offset-4 hover:underline',
};

const sizeClasses = {
  sm: iconOnly ? 'p-2 text-sm' : 'px-3 py-2 text-sm',
  md: iconOnly ? 'p-2.5 text-sm' : 'px-3.5 py-2.5 text-sm',
  lg: iconOnly ? 'p-3 text-base' : 'px-4.5 py-3 text-base',
  xl: iconOnly ? 'p-3 text-base' : 'px-5 py-3 text-base',
};

const classes = cn(
  'inline-flex items-center justify-center gap-2 rounded-full font-semibold whitespace-nowrap transition-colors cursor-pointer',
  'focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-ring',
  'disabled:pointer-events-none disabled:opacity-50',
  variantClasses[variant],
  sizeClasses[size],
  className
);
---

{
  href ? (
    <a
      href={href}
      class={classes}
      aria-disabled={isDisabled || undefined}
      aria-busy={loading || undefined}
      {...rest}
    >
      {loading && (
        <span
          class="size-4 animate-spin rounded-full border-2 border-current border-t-transparent"
          aria-hidden="true"
        />
      )}
      {hasLeadingIcon && <slot name="icon-leading" />}
      {!iconOnly && label}
      {hasTrailingIcon && <slot name="icon-trailing" />}
      {loading && <span class="sr-only">Loading</span>}
    </a>
  ) : (
    <button
      type={type}
      class={classes}
      disabled={isDisabled}
      aria-busy={loading || undefined}
      {...rest}
    >
      {loading && (
        <span
          class="size-4 animate-spin rounded-full border-2 border-current border-t-transparent"
          aria-hidden="true"
        />
      )}
      {hasLeadingIcon && <slot name="icon-leading" />}
      {!iconOnly && label}
      {hasTrailingIcon && <slot name="icon-trailing" />}
      {loading && <span class="sr-only">Loading</span>}
    </button>
  )
}
