---
import type { HeroSectionProps } from './HeroSection.types';
import Button from '@/components/Forms/Button/Button.astro';

type Props = HeroSectionProps;

const { headline, subCopy, primaryCta, secondaryCta, image } = Astro.props;
---

<section class="py-12 lg:py-24">
  <div class="container flex flex-col gap-16">
    <div class="flex flex-col gap-12">
      <div class="flex flex-col gap-6">
        <h1
          class="text-display-md font-medium tracking-display-md text-brand-900 lg:text-display-xl lg:tracking-display-xl max-w-[1024px]"
        >
          {headline}
        </h1>
        <p class="text-base text-gray-600 max-w-[640px]">
          {subCopy}
        </p>
      </div>
      <div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap">
        <Button
          label={primaryCta.label}
          href={primaryCta.href}
          size="lg"
          class="w-full sm:w-auto"
        />
        {
          secondaryCta && (
            <Button
              label={secondaryCta.label}
              href={secondaryCta.href}
              size="lg"
              variant="outline"
              class="w-full sm:w-auto"
            />
          )
        }
      </div>
    </div>
    {
      image && (
        <div class="w-full">
          <img
            src={image.src}
            alt={image.alt}
            class="w-full aspect-[4/3] lg:aspect-[1216/516] object-cover"
            loading="eager"
          />
        </div>
      )
    }
  </div>
</section>
