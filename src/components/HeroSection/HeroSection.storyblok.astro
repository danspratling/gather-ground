---
import type { SbBlokData } from '@storyblok/astro';
import HeroSection from './HeroSection.astro';

interface Props {
  blok: SbBlokData;
}

const { blok } = Astro.props;
const image = blok.image as { filename: string } | undefined;
---

<HeroSection
  headline={blok.headline as string}
  subCopy={blok.sub_copy as string}
  primaryCta={{
    label: blok.primary_cta_label as string,
    href: blok.primary_cta_href as string,
  }}
  secondaryCta={{
    label: blok.secondary_cta_label as string,
    href: blok.secondary_cta_href as string,
  }}
  image={{ src: image?.filename ?? '', alt: blok.image_alt as string }}
/>
