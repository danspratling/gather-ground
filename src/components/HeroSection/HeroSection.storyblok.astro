---
import type { SbBlokData } from '@storyblok/astro';
import HeroSection from './HeroSection.astro';

interface Props {
  blok: SbBlokData;
}

const { blok } = Astro.props;
const imageAsset = blok.image as { filename: string; alt: string } | undefined;
const secondaryCtaLabel = blok.secondary_cta_label as string | undefined;
---

<HeroSection
  headline={blok.headline as string}
  subCopy={blok.sub_copy as string}
  primaryCta={{
    label: blok.primary_cta_label as string,
    href: blok.primary_cta_href as string,
  }}
  secondaryCta={secondaryCtaLabel
    ? {
        label: secondaryCtaLabel,
        href: blok.secondary_cta_href as string,
      }
    : undefined}
  image={imageAsset
    ? { src: imageAsset.filename, alt: imageAsset.alt }
    : undefined}
/>
