---
import { cn } from '@/lib/utils';
import type { AvatarLabelGroupProps } from '@/components/Avatar/Avatar.types';
import Avatar from './Avatar.astro';

type Props = AvatarLabelGroupProps;

const {
  src,
  alt,
  name,
  secondary,
  secondaryIsHandle = false,
  size = 'md',
  class: className,
} = Astro.props;

// Avatar size maps to AvatarSize — AvatarLabelGroup only exposes sm–xl
const avatarSize = size;
---

<div class={cn('flex items-center gap-2', className)}>
  {src && <Avatar src={src} alt={alt ?? ''} size={avatarSize} />}
  <div class="flex flex-col gap-1">
    <span class="text-sm font-semibold text-brand-900">{name}</span>
    {
      secondary && (
        <span
          class={cn(
            'text-sm font-normal text-brand-400',
            secondaryIsHandle && 'underline'
          )}
        >
          {secondary}
        </span>
      )
    }
  </div>
</div>
