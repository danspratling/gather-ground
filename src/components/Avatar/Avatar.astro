---
import { cn } from '@/lib/utils';
import type { AvatarProps } from '@/types/avatar';

type Props = AvatarProps;

const { src, alt, size = 'md', class: className } = Astro.props;

// Diameter and border width per size
const sizeClasses = {
  xs: 'size-6',
  sm: 'size-8',
  md: 'size-10',
  lg: 'size-12',
  xl: 'size-14',
  '2xl': 'size-16',
} as const;

const borderClasses = {
  xs: 'border-[0.5px]',
  sm: 'border-[0.5px]',
  md: 'border',
  lg: 'border',
  xl: 'border-[1.5px]',
  '2xl': 'border-[1.5px]',
} as const;
---

<img
  src={src}
  alt={alt}
  class={cn(
    'rounded-full object-cover border-[rgba(0,0,0,0.08)] shrink-0',
    sizeClasses[size],
    borderClasses[size],
    className
  )}
/>
