---
import { cn } from '@/lib/utils';
import type { AvatarProps } from '@/components/Avatar/Avatar.types';

type Props = AvatarProps;

const { src, alt, size = 'md', class: className } = Astro.props;

// Diameter and border width per size
const sizeClasses = {
  xs: 'size-6',
  sm: 'size-8',
  md: 'size-10',
  lg: 'size-12',
  xl: 'size-14',
  '2xl': 'size-16',
} as const;

const borderClasses = {
  xs: 'border-0.5',
  sm: 'border-0.5',
  md: 'border',
  lg: 'border',
  xl: 'border-1.5',
  '2xl': 'border-1.5',
} as const;
---

<img
  src={src}
  alt={alt}
  width={48}
  height={48}
  loading="lazy"
  decoding="async"
  class={cn(
    'rounded-full object-cover border-black/8 shrink-0',
    sizeClasses[size],
    borderClasses[size],
    className
  )}
/>
