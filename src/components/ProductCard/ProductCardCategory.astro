---
import { cn } from '@/lib/utils';
import type { ProductCardProps } from '@/components/ProductCard/ProductCard.types';

type Props = Omit<ProductCardProps, 'variant'>;

const {
  image,
  imageAlt,
  title,
  description,
  href,
  class: className,
} = Astro.props;
---

<article class={cn('rounded-xl bg-secondary-50 overflow-hidden', className)}>
  <a href={href} class="group flex flex-col gap-4">
    <div class="overflow-hidden">
      <img
        src={image}
        alt={imageAlt}
        class="h-48 w-full object-cover transition-transform duration-300 group-hover:scale-105 group-focus:scale-105"
      />
    </div>
    <div class="flex flex-col gap-2 p-6 pt-0">
      <h3
        class="text-lg font-semibold text-gray-900 group-hover:underline group-focus:underline"
      >
        {title}
      </h3>
      {
        description && (
          <p class="text-sm font-normal text-gray-600">{description}</p>
        )
      }
      <p class="text-sm font-semibold text-gray-900 mt-2">See more &rarr;</p>
    </div>
  </a>
</article>
