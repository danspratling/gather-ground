---
import type { OrderConfirmationProps } from './OrderConfirmation.types';

type Props = OrderConfirmationProps;
const {
  orderId,
  orderNumber,
  customerEmail,
  isAuthenticated = false,
} = Astro.props;

const displayNumber = orderNumber ?? orderId;
---

<div class="space-y-10 text-center">
  <!-- Success icon -->
  <div class="flex justify-center">
    <div
      class="flex size-20 items-center justify-center rounded-full bg-terracotta-100"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="36"
        height="36"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="text-terracotta-600"
        aria-hidden="true"
      >
        <path d="M20 6 9 17l-5-5"></path>
      </svg>
    </div>
  </div>

  <!-- Copy -->
  <div class="space-y-3">
    <h1 class="font-heading text-3xl font-bold text-brand-900">
      Thank you for your order!
    </h1>
    <p class="text-lg text-brand-600">
      Order <span class="font-semibold">#{displayNumber}</span> is confirmed.
    </p>
    {
      customerEmail && (
        <p class="text-sm text-brand-500">
          A confirmation has been sent to{' '}
          <span class="font-medium">{customerEmail}</span>.
        </p>
      )
    }
  </div>

  <!-- CTAs -->
  <div class="flex flex-col items-center gap-4 sm:flex-row sm:justify-center">
    <a
      href="/"
      class="inline-flex h-11 items-center rounded-full bg-brand-900 px-8 text-sm font-semibold text-off-white transition-colors hover:bg-brand-700"
    >
      Continue shopping
    </a>
    {
      isAuthenticated && (
        <a
          href={`/account/orders/${orderId}`}
          class="inline-flex h-11 items-center rounded-full border border-brand-200 px-8 text-sm font-semibold text-brand-900 transition-colors hover:bg-brand-25"
        >
          View order details
        </a>
      )
    }
  </div>
</div>
