---
import { cn } from '@/lib/utils';
import type { TestimonialCardProps } from '@/components/TestimonialCard.types';
import AvatarLabelGroup from '@/components/Avatar/AvatarLabelGroup.astro';

type Props = TestimonialCardProps;

const { quote, platform, author, class: className } = Astro.props;

const platformLabel: Record<NonNullable<typeof platform>, string> = {
  twitter: 'Twitter / X',
  instagram: 'Instagram',
  facebook: 'Facebook',
  tiktok: 'TikTok',
  linkedin: 'LinkedIn',
};
---

<article
  class={cn('flex flex-col gap-6 rounded-xl bg-secondary-50 p-8', className)}
>
  {
    platform && (
      <p class="text-sm font-medium text-gray-600">{platformLabel[platform]}</p>
    )
  }
  <blockquote class="text-base font-normal text-gray-900">
    &ldquo;{quote}&rdquo;
  </blockquote>
  <AvatarLabelGroup
    src={author.src}
    alt={author.alt}
    name={author.name}
    secondary={author.secondary}
    secondaryIsHandle={author.secondaryIsHandle}
    size={author.size ?? 'md'}
  />
</article>
