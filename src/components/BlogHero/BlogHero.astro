---
import { cn } from '@/lib/utils';
import type { BlogHeroProps } from '@/components/BlogHero/BlogHero.types';
import Label from '@/components/Typography/Label/Label.astro';
import Heading from '@/components/Typography/Heading/Heading.astro';
import Body from '@/components/Typography/Body/Body.astro';
import Input from '@/components/Forms/Input/Input.astro';
import Button from '@/components/Forms/Button/Button.astro';

type Props = BlogHeroProps;

const {
  eyebrow,
  heading,
  subCopy,
  privacyPolicyHref,
  class: className,
} = Astro.props;
---

<section class={cn('bg-off-white py-24', className)}>
  <div class="container">
    <div class="flex flex-col gap-8 lg:max-w-[640px]">
      <div class="flex flex-col gap-6">
        <div class="flex flex-col gap-3">
          <Label size="sm" class="text-brand-700">{eyebrow}</Label>
          <Heading
            as="h1"
            size="display-md"
            class="text-brand-900 lg:text-display-lg lg:tracking-display-lg"
          >
            {heading}
          </Heading>
        </div>
        <Body size="lg" class="text-gray-600 lg:text-xl">{subCopy}</Body>
      </div>
      {
        privacyPolicyHref !== undefined && (
          <form
            action="/api/newsletter"
            method="POST"
            class="flex flex-col gap-3 sm:flex-row sm:items-start sm:max-w-[480px]"
          >
            <div class="flex flex-col gap-1.5 flex-1">
              <Input
                name="email"
                type="email"
                placeholder="Enter your email"
                iconTrailing={false}
                required
              />
              <p class="text-sm text-gray-600">
                We care about your data in our{' '}
                <a
                  href={privacyPolicyHref}
                  class="underline hover:text-gray-700"
                >
                  privacy policy
                </a>
                .
              </p>
            </div>
            <Button label="Get started" type="submit" />
          </form>
        )
      }
    </div>
  </div>
</section>
