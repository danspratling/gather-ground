---
import { cn } from '@/lib/utils';
import type { InputProps } from '@/types/input';

type Props = InputProps;

const {
  name,
  label,
  required = false,
  placeholder,
  type = 'text',
  size = 'md',
  hint,
  error,
  disabled = false,
  iconLeading = false,
  class: className,
} = Astro.props;

const hasError = Boolean(error);
const hintId = hint || error ? `${name}-hint` : undefined;

const sizeClasses = {
  sm: 'px-3 py-2 text-sm',
  md: 'px-3.5 py-2.5 text-sm',
};

const inputClasses = cn(
  'w-full rounded-lg border bg-off-white text-brand-900 shadow-xs transition-colors',
  'placeholder:text-brand-300',
  'focus:outline-none focus:border-brand-700 focus:ring-1 focus:ring-brand-700',
  'disabled:pointer-events-none disabled:opacity-50 disabled:bg-brand-25',
  hasError
    ? 'border-destructive focus:border-destructive focus:ring-destructive'
    : 'border-brand-100',
  sizeClasses[size],
  iconLeading ? 'pl-10' : '',
  className
);
---

<div class="flex flex-col gap-1.5">
  {
    label && (
      <label for={name} class="text-sm font-medium text-brand-700">
        {label}
        {required && (
          <span class="ml-0.5 text-brand-800" aria-hidden="true">
            *
          </span>
        )}
      </label>
    )
  }

  <div class="relative">
    {
      iconLeading && (
        <span
          class="pointer-events-none absolute inset-y-0 left-3 flex items-center text-brand-400"
          aria-hidden="true"
        >
          <svg
            width="20"
            height="20"
            viewBox="0 0 20 20"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            aria-hidden="true"
          >
            <circle cx="9" cy="9" r="6" />
            <path d="m15 15 3 3" stroke-linecap="round" />
          </svg>
        </span>
      )
    }

    <input
      id={name}
      name={name}
      type={type}
      placeholder={placeholder}
      required={required || undefined}
      disabled={disabled || undefined}
      aria-required={required || undefined}
      aria-invalid={hasError || undefined}
      aria-describedby={hintId}
      class={inputClasses}
    />

    {
      !iconLeading && (
        <span
          class="pointer-events-none absolute inset-y-0 right-3 flex items-center text-brand-400"
          aria-hidden="true"
        >
          <svg
            width="16"
            height="16"
            viewBox="0 0 16 16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            aria-hidden="true"
          >
            <circle cx="8" cy="8" r="6" />
            <path d="M8 5v1M8 8v3" stroke-linecap="round" />
          </svg>
        </span>
      )
    }
  </div>

  {
    (error || hint) && (
      <p
        id={hintId}
        class={cn('text-sm', hasError ? 'text-destructive' : 'text-brand-400')}
      >
        {error ?? hint}
      </p>
    )
  }
</div>
