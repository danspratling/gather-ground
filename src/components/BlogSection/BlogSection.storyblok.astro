---
import type { SbBlokData } from '@storyblok/astro';
import { storyblokEditable } from '@storyblok/astro';
import BlogSection from './BlogSection.astro';
import { resolveLink } from '@/lib/utils';
import { getStoryAuthors } from '@/lib/storyblokAuthors';

interface Props {
  blok: SbBlokData;
}

const { blok } = Astro.props;

interface ResolvedBlogPost {
  id: number;
  full_slug: string;
  first_published_at: string;
  created_at: string;
  content: {
    image?: { filename: string; alt: string };
    title: string;
    excerpt: string;
  };
}

const rawPosts = blok.posts as ResolvedBlogPost[];
const spaceId = import.meta.env.STORYBLOK_SPACE_ID;
const authorMap = await getStoryAuthors(
  spaceId,
  rawPosts.map((p) => p.id)
);

const posts = rawPosts.map((p) => {
  const a = authorMap.get(p.id) ?? { name: '', avatarUrl: '' };
  const date = new Date(
    p.first_published_at ?? p.created_at
  ).toLocaleDateString('en-GB', {
    day: 'numeric',
    month: 'short',
    year: 'numeric',
  });
  return {
    image: p.content.image?.filename ?? '',
    imageAlt: p.content.image?.alt ?? '',
    title: p.content.title,
    excerpt: p.content.excerpt,
    date,
    authorName: a.name,
    authorImage: a.avatarUrl,
    authorImageAlt: a.name,
    href: `/${p.full_slug}`,
  };
});
---

<div {...storyblokEditable(blok)}>
  <BlogSection
    eyebrow={(blok.eyebrow as string | undefined) ?? ''}
    heading={blok.heading as string}
    subCopy={(blok.sub_copy as string | undefined) ?? ''}
    viewAllHref={resolveLink(blok.view_all_href)}
    viewAllLabel={blok.view_all_label as string | undefined}
    posts={posts}
  />
</div>
