---
import type { SbBlokData } from '@storyblok/astro';
import BlogSection from './BlogSection.astro';
import { resolveLink } from '@/lib/utils';

interface Props {
  blok: SbBlokData;
}

const { blok } = Astro.props;

interface ResolvedBlogPost {
  full_slug: string;
  content: {
    image?: { filename: string; alt: string };
    title: string;
    excerpt: string;
    date: string;
    author_name: string;
    author_image?: { filename: string; alt: string };
  };
}

const posts = (blok.posts as ResolvedBlogPost[]).map((p) => ({
  image: p.content.image?.filename ?? '',
  imageAlt: p.content.image?.alt ?? '',
  title: p.content.title,
  excerpt: p.content.excerpt,
  date: p.content.date,
  authorName: p.content.author_name,
  authorImage: p.content.author_image?.filename ?? '',
  authorImageAlt: p.content.author_image?.alt ?? '',
  href: `/${p.full_slug}`,
}));
---

<BlogSection
  eyebrow={(blok.eyebrow as string | undefined) ?? ''}
  heading={blok.heading as string}
  subCopy={(blok.sub_copy as string | undefined) ?? ''}
  viewAllHref={resolveLink(blok.view_all_href)}
  viewAllLabel={blok.view_all_label as string | undefined}
  posts={posts}
/>
