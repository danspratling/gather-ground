---
import type { SbBlokData } from '@storyblok/astro';
import BlogSection from './BlogSection.astro';
import { resolveLink } from '@/lib/utils';

interface Props {
  blok: SbBlokData;
}

const { blok } = Astro.props;
const posts = (blok.posts as SbBlokData[]).map((p) => ({
  image:
    (p.image as { filename: string; alt: string } | undefined)?.filename ?? '',
  imageAlt:
    (p.image as { filename: string; alt: string } | undefined)?.alt ?? '',
  title: p.title as string,
  excerpt: p.excerpt as string,
  date: p.date as string,
  authorName: p.author_name as string,
  authorImage:
    (p.author_image as { filename: string; alt: string } | undefined)
      ?.filename ?? '',
  authorImageAlt:
    (p.author_image as { filename: string; alt: string } | undefined)?.alt ??
    '',
  href: resolveLink(p.href),
}));
---

<BlogSection
  eyebrow={(blok.eyebrow as string | undefined) ?? ''}
  heading={blok.heading as string}
  subCopy={(blok.sub_copy as string | undefined) ?? ''}
  viewAllHref={resolveLink(blok.view_all_href)}
  viewAllLabel={blok.view_all_label as string | undefined}
  posts={posts}
/>
