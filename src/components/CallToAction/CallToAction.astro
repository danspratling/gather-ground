---
import { cn } from '@/lib/utils';
import type { CallToActionProps } from '@/components/CallToAction/CallToAction.types';
import Heading from '@/components/Typography/Heading/Heading.astro';
import Body from '@/components/Typography/Body/Body.astro';
import Button from '@/components/Forms/Button/Button.astro';
import AvatarGroup from '@/components/Avatar/AvatarGroup.astro';

type Props = CallToActionProps;

const {
  heading,
  body,
  primaryButton,
  secondaryButton,
  avatarGroup,
  class: className,
} = Astro.props;
---

<div
  class={cn(
    'flex flex-col gap-8 rounded-2xl bg-secondary-50 px-8 pb-10 pt-8',
    className
  )}
>
  <div class="flex flex-col gap-4">
    <Heading as="h3" size="text-xl" weight="semibold" text={heading} />
    <Body size="md" text={body} class="text-gray-600" />
  </div>
  <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
    <Button
      label={primaryButton.label}
      href={primaryButton.href}
      variant={primaryButton.variant ?? 'default'}
      size={primaryButton.size ?? 'md'}
    />
    {
      secondaryButton && (
        <Button
          label={secondaryButton.label}
          href={secondaryButton.href}
          variant={secondaryButton.variant ?? 'outline'}
          size={secondaryButton.size ?? 'md'}
        />
      )
    }
  </div>
  {
    avatarGroup && avatarGroup.avatars.length > 0 && (
      <AvatarGroup avatars={avatarGroup.avatars} size={avatarGroup.size} />
    )
  }
</div>
