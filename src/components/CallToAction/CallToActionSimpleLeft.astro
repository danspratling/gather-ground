---
import type { CallToActionSimpleLeftProps } from './CallToAction.types';
import Button from '@/components/Forms/Button/Button.astro';

type Props = Omit<CallToActionSimpleLeftProps, 'variant'>;

const { heading, body, primaryCta, secondaryCta } = Astro.props;
---

<section class="py-24">
  <div
    class="container flex flex-col lg:flex-row lg:items-start lg:justify-between gap-8"
  >
    <div class="flex flex-col gap-5 max-w-3xl">
      <h2
        class="text-display-md font-semibold tracking-display-md text-brand-900"
      >
        {heading}
      </h2>
      <p class="text-xl font-normal text-brand-500">
        {body}
      </p>
    </div>
    <div class="flex flex-col lg:flex-row-reverse gap-3 shrink-0">
      <Button
        label={primaryCta.label}
        href={primaryCta.href}
        variant="default"
        class="w-full lg:w-auto"
      />
      {
        secondaryCta && (
          <Button
            label={secondaryCta.label}
            href={secondaryCta.href}
            variant="outline"
            class="w-full lg:w-auto"
          />
        )
      }
    </div>
  </div>
</section>
