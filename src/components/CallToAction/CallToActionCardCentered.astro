---
import type { CallToActionCardCenteredProps } from './CallToAction.types';
import Button from '@/components/Forms/Button/Button.astro';

type Props = Omit<CallToActionCardCenteredProps, 'variant'>;

const { heading, body, primaryCta, secondaryCta } = Astro.props;
---

<section class="py-24">
  <div class="container">
    <div
      class="bg-brand-700 rounded-2xl p-16 flex flex-col items-center text-center gap-8"
    >
      <div class="flex flex-col gap-5 max-w-3xl">
        <h2
          class="text-display-md font-semibold tracking-display-md text-brand-25"
        >
          {heading}
        </h2>
        <p class="text-xl font-normal text-brand-200 max-w-2xl mx-auto">
          {body}
        </p>
      </div>
      <div class="flex flex-col sm:flex-row items-center gap-3">
        {
          secondaryCta && (
            <Button
              label={secondaryCta.label}
              href={secondaryCta.href}
              variant="default"
            />
          )
        }
        <Button
          label={primaryCta.label}
          href={primaryCta.href}
          variant="outline"
        />
      </div>
    </div>
  </div>
</section>
