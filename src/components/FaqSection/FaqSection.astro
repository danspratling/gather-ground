---
import type { FaqSectionProps } from '@/components/FaqSection/FaqSection.types';
import Accordion from '@/components/Accordion/Accordion';
import Heading from '@/components/Typography/Heading/Heading.astro';
import Body from '@/components/Typography/Body/Body.astro';
import Button from '@/components/Forms/Button/Button.astro';
import AvatarGroup from '@/components/Avatar/AvatarGroup.astro';

type Props = FaqSectionProps;

const { heading, subCopy, items, cta } = Astro.props;
---

<section class="py-12 lg:py-24">
  <div class="container flex flex-col gap-12">
    <div class="mx-auto w-full max-w-[768px] flex flex-col gap-12">
      <div class="flex flex-col items-center gap-5 text-center">
        <h2
          class="text-display-md font-semibold tracking-display-md text-gray-900 lg:text-display-lg"
        >
          {heading}
        </h2>
        <p class="text-xl text-gray-600">{subCopy}</p>
      </div>
      <Accordion client:visible items={items} />
    </div>
    {
      cta && (
        <div class="flex flex-col items-center text-center gap-8 rounded-2xl bg-secondary-50 px-8 pb-10 pt-8">
          {cta.avatarGroup && cta.avatarGroup.avatars.length > 0 && (
            <AvatarGroup
              avatars={cta.avatarGroup.avatars}
              size={cta.avatarGroup.size}
            />
          )}
          <div class="flex flex-col gap-4">
            <Heading
              as="h3"
              size="text-xl"
              weight="semibold"
              text={cta.heading}
            />
            <Body size="md" text={cta.body} class="text-gray-600" />
          </div>
          <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-center">
            {cta.secondaryButton && (
              <Button
                label={cta.secondaryButton.label}
                href={cta.secondaryButton.href}
                variant={cta.secondaryButton.variant ?? 'outline'}
                size={cta.secondaryButton.size ?? 'md'}
              />
            )}
            <Button
              label={cta.primaryButton.label}
              href={cta.primaryButton.href}
              variant={cta.primaryButton.variant ?? 'default'}
              size={cta.primaryButton.size ?? 'md'}
            />
          </div>
        </div>
      )
    }
  </div>
</section>
