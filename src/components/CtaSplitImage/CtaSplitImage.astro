---
import type { CtaSplitImageProps } from './CtaSplitImage.types';
import Button from '@/components/Forms/Button/Button.astro';

type Props = CtaSplitImageProps;

const { heading, body, primaryCta, secondaryCta, image } = Astro.props;
---

<section class="py-24">
  <div class="container flex flex-col-reverse lg:flex-row gap-16 items-center">
    <!-- Content column -->
    <div class="flex flex-col gap-6 flex-1 min-w-0">
      <div class="flex flex-col gap-4">
        <h2
          class="text-display-lg font-semibold tracking-display-lg text-brand-900"
        >
          {heading}
        </h2>
        <p class="text-xl font-normal text-gray-600">
          {body}
        </p>
      </div>
      <div
        class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3"
      >
        {
          secondaryCta && (
            <Button
              label={secondaryCta.label}
              href={secondaryCta.href}
              variant="outline"
            />
          )
        }
        <Button
          label={primaryCta.label}
          href={primaryCta.href}
          variant="default"
        />
      </div>
    </div>

    <!-- Image column -->
    <div class="flex-1 min-w-0 w-full lg:w-auto">
      <img
        src={image.src}
        alt={image.alt}
        class="w-full rounded-2xl object-cover aspect-[4/5]"
        loading="lazy"
      />
    </div>
  </div>
</section>
