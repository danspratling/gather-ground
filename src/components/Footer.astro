---
import NewsletterForm from '@/components/NewsletterForm';
import FacebookIcon from '@/components/Icons/FacebookIcon.astro';
import InstagramIcon from '@/components/Icons/InstagramIcon.astro';
import LinkedInIcon from '@/components/Icons/LinkedInIcon.astro';
import TikTokIcon from '@/components/Icons/TikTokIcon.astro';
import TwitterIcon from '@/components/Icons/TwitterIcon.astro';
import type { FooterProps, SocialPlatform } from '@/types/footer';

type Props = FooterProps;

const {
  logoSrc,
  logoAlt,
  description,
  socialLinks,
  linkGroups,
  newsletterHeading,
  copyrightText,
  legalLinks,
}: Props = Astro.props;

const SOCIAL_ICONS: Record<SocialPlatform, typeof InstagramIcon> = {
  instagram: InstagramIcon,
  facebook: FacebookIcon,
  tiktok: TikTokIcon,
  twitter: TwitterIcon,
  linkedin: LinkedInIcon,
};
---

<footer class="bg-gray-950 flex flex-col items-center gap-16 pb-12 pt-16">
  <!-- Main content -->
  <div class="flex w-full max-w-7xl flex-col items-start px-8">
    <div
      class="flex w-full flex-wrap items-start justify-between gap-y-12"
      data-testid="footer-content"
    >
      <!-- Logo, description, social links -->
      <div class="flex min-w-80 max-w-80 flex-col gap-8">
        <a href="/" class="block w-fit" aria-label="Gather Ground home">
          <img src={logoSrc} alt={logoAlt} class="h-8 w-auto" />
        </a>
        <p class="text-base text-brand-100">{description}</p>
        <div class="flex items-center gap-6" aria-label="Social media links">
          {
            socialLinks.map((link) => {
              const Icon = SOCIAL_ICONS[link.platform];
              return (
                <a
                  href={link.href}
                  aria-label={link.label}
                  class="text-brand-400 transition-colors hover:text-brand-200"
                >
                  <Icon />
                </a>
              );
            })
          }
        </div>
      </div>

      <!-- Link groups and newsletter -->
      <div class="flex flex-wrap items-start gap-8">
        <!-- Link columns -->
        <div class="flex gap-8">
          {
            linkGroups.map((group) => (
              <div class="flex min-w-24 flex-1 flex-col gap-4">
                <p class="text-sm font-semibold text-brand-400">
                  {group.heading}
                </p>
                <ul class="flex flex-col gap-3">
                  {group.links.map((link) => (
                    <li class="flex items-center gap-2">
                      <a
                        href={link.href}
                        class="text-base font-semibold text-brand-200 transition-colors hover:text-brand-100"
                      >
                        {link.label}
                      </a>
                      {link.badge && (
                        <span class="rounded-md border border-gray-700 px-1.5 py-0.5 text-xs font-medium text-brand-200 shadow-xs">
                          {link.badge}
                        </span>
                      )}
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>

        <!-- Newsletter form -->
        <div class="w-90">
          <NewsletterForm heading={newsletterHeading} client:visible />
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="flex w-full max-w-7xl flex-col items-start px-8">
    <div
      class="flex w-full flex-wrap items-center justify-between gap-y-6 border-t border-gray-800 pt-8 text-base text-gray-400"
    >
      <p>{copyrightText}</p>
      <ul class="flex gap-4">
        {
          legalLinks.map((link) => (
            <li>
              <a href={link.href} class="transition-colors hover:text-gray-200">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</footer>
