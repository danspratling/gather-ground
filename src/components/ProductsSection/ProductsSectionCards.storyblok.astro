---
import type { SbBlokData } from '@storyblok/astro';
import ProductsSection from './ProductsSection.astro';
import { resolveLink } from '@/lib/utils';

interface Props {
  blok: SbBlokData;
}

const { blok } = Astro.props;
const products = (blok.products as SbBlokData[]).map((p) => ({
  image:
    (p.image as { filename: string; alt: string } | undefined)?.filename ?? '',
  imageAlt:
    (p.image as { filename: string; alt: string } | undefined)?.alt ?? '',
  title: p.title as string,
  description: p.description as string | undefined,
  href: resolveLink(p.href),
}));
---

<ProductsSection
  variant="cards"
  eyebrow={blok.eyebrow as string}
  heading={blok.heading as string}
  subCopy={blok.sub_copy as string}
  products={products}
/>
