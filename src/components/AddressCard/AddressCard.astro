---
import { cn } from '@/lib/utils';
import type { AddressCardProps } from './AddressCard.types';
import Badge from '@/components/Badge/Badge.astro';

type Props = AddressCardProps;

const { address } = Astro.props;
const {
  firstName,
  lastName,
  line1,
  line2,
  city,
  postcode,
  country,
  isDefaultShipping,
  isDefaultBilling,
} = address;
---

<div
  class={cn(
    'relative flex h-full flex-col rounded-lg border border-gray-200 bg-white p-4'
  )}
>
  {
    (isDefaultShipping || isDefaultBilling) && (
      <div class="absolute left-4 top-0 flex -translate-y-1/2 flex-wrap gap-2">
        {isDefaultShipping && <Badge label="Default shipping" color="brand" />}
        {isDefaultBilling && <Badge label="Default billing" color="gray" />}
      </div>
    )
  }
  <address class="flex-1 space-y-0.5 not-italic text-sm text-brand-600">
    <p class="font-semibold text-brand-900">{firstName} {lastName}</p>
    <p>{line1}</p>
    {line2 && <p>{line2}</p>}
    <p>{city}, {postcode}</p>
    <p>{country}</p>
  </address>
  <div class="mt-4">
    <slot name="actions" />
  </div>
</div>
