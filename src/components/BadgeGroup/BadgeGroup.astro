---
import { cn } from '@/lib/utils';
import type { BadgeGroupProps } from '@/components/BadgeGroup/BadgeGroup.types';
import Badge from '@/components/Badge/Badge.astro';

type Props = BadgeGroupProps;

const {
  badges,
  color = 'gray',
  size = 'sm',
  type = 'pill',
  class: className,
} = Astro.props;
---

<div class={cn('flex flex-wrap gap-2', className)}>
  {badges.map((label) => <Badge {label} {color} {size} type={type} />)}
</div>
