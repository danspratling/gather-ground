---
import type { ProductDetailProps } from './ProductDetail.types';
import VariantPicker from '@/components/VariantPicker/VariantPicker';
import AddToCartButton from '@/components/Forms/AddToCartButton/AddToCartButton';

type Props = ProductDetailProps;

const {
  title,
  description,
  images,
  options,
  variants,
  selectedVariantId,
  class: className,
} = Astro.props;

const firstImage = images[0];
const defaultVariant =
  variants.find((v) => v.id === selectedVariantId) ?? variants[0];
const initialPrice = defaultVariant?.price.formatted ?? '';
const initialVariantId = defaultVariant?.id ?? '';
const initialInventoryStatus =
  defaultVariant?.inventoryStatus ?? 'out_of_stock';
---

<div
  class:list={['grid grid-cols-1 gap-8 lg:grid-cols-5 lg:gap-12', className]}
>
  {/* Image area — full width on mobile, 60% (3 of 5 columns) on desktop */}
  <div class="lg:col-span-3">
    {
      firstImage ? (
        <img
          src={firstImage.url}
          alt={firstImage.altText ?? title}
          class="w-full aspect-square object-cover rounded-2xl"
          width={800}
          height={800}
          loading="eager"
          decoding="async"
        />
      ) : (
        <div class="w-full aspect-square bg-secondary-100 rounded-2xl flex items-center justify-center">
          <span class="text-secondary-400 text-sm">No image available</span>
        </div>
      )
    }
  </div>

  {/* Info area — full width on mobile, 40% (2 of 5 columns) on desktop */}
  <div class="flex flex-col gap-6 lg:col-span-2">
    <div class="flex flex-col gap-3">
      <h1
        class="text-display-sm font-semibold text-brand-900 lg:text-display-md lg:tracking-display-md"
      >
        {title}
      </h1>
      {description && <p class="text-base text-brand-500">{description}</p>}
    </div>

    <p id="product-price" class="text-display-xs font-semibold text-brand-900">
      {initialPrice}
    </p>

    <VariantPicker
      options={options}
      variants={variants}
      selectedVariantId={initialVariantId}
      client:visible
    />

    <AddToCartButton
      variantId={initialVariantId}
      inventoryStatus={initialInventoryStatus}
      client:visible
    />
  </div>
</div>

<script>
  window.addEventListener('variant:selected', (e: Event) => {
    const event = e as CustomEvent<{
      variantId: string;
      price: { formatted: string };
      oos: boolean;
    }>;
    const priceEl = document.getElementById('product-price');
    if (priceEl && event.detail.price?.formatted) {
      priceEl.textContent = event.detail.price.formatted;
    }
  });
</script>
