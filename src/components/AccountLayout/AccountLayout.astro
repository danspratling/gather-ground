---
import type { AccountLayoutProps } from './AccountLayout.types';

type Props = AccountLayoutProps;

const { customerName, pathname } = Astro.props;

const navLinks = [
  { label: 'Dashboard', href: '/account' },
  { label: 'Orders', href: '/account/orders' },
  { label: 'Addresses', href: '/account/addresses' },
  { label: 'Profile', href: '/account/profile' },
];

const isActive = (href: string) =>
  href === '/account' ? pathname === href : pathname.startsWith(href);
---

<div class="min-h-screen bg-off-white">
  <!-- Mobile nav header -->
  <div class="border-b border-gray-200 bg-white md:hidden">
    <div class="px-4 py-3">
      <p class="text-sm text-gray-800">
        Welcome, <span class="font-semibold text-brand-900">{customerName}</span
        >
      </p>
    </div>
    <nav aria-label="Account navigation tabs" class="flex overflow-x-auto">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class:list={[
              'flex-shrink-0 whitespace-nowrap border-b-2 px-4 py-3 text-sm font-medium',
              isActive(link.href)
                ? 'border-brand-900 bg-white text-brand-900'
                : 'border-transparent text-gray-800 hover:text-brand-900',
            ]}
          >
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>

  <div class="mx-auto max-w-7xl px-4 py-8 md:flex md:gap-8">
    <!-- Desktop sidebar -->
    <aside class="hidden md:block md:w-64 shrink-0">
      <div class="mb-6">
        <p class="text-sm text-gray-800">Welcome back,</p>
        <p class="font-semibold text-brand-900">{customerName}</p>
      </div>
      <nav aria-label="Account navigation sidebar" class="flex flex-col gap-1">
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              class:list={[
                'rounded-lg px-3 py-2 text-sm font-medium',
                isActive(link.href)
                  ? 'bg-white font-semibold text-brand-900'
                  : 'text-gray-800 hover:bg-gray-50 hover:text-brand-900',
              ]}
            >
              {link.label}
            </a>
          ))
        }
      </nav>
      <div class="mt-6 border-t border-gray-200 pt-6">
        <form method="POST" action="/api/commerce/auth/logout">
          <button
            type="submit"
            class="w-full rounded-lg px-3 py-2 text-left text-sm font-medium text-gray-800 hover:bg-gray-50 hover:text-brand-900"
          >
            Sign out
          </button>
        </form>
      </div>
    </aside>

    <!-- Mobile sign out -->
    <div class="mb-4 md:hidden">
      <form method="POST" action="/api/commerce/auth/logout">
        <button
          type="submit"
          class="text-sm text-gray-800 hover:text-brand-900"
        >
          Sign out
        </button>
      </form>
    </div>

    <!-- Main content -->
    <main class="min-w-0 flex-1">
      <slot />
    </main>
  </div>
</div>
