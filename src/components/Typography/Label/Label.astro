---
import { cn } from '@/lib/utils';
import type { LabelProps } from '@/components/Typography/Label/Label.types';

type Props = LabelProps;

const { size = 'md', color, text, class: className } = Astro.props;

const sizeClasses = {
  sm: 'text-sm font-semibold',
  md: 'text-base font-semibold',
};

const classes = cn(sizeClasses[size], className);
---

<span class={classes} style={color ? `color: ${color}` : undefined}>
  {text ?? <slot />}
</span>
