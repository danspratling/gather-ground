---
import type { PreviewBannerProps } from './PreviewBanner.types';

const { doc } = Astro.props as PreviewBannerProps;

const isDraft = Boolean(doc._originalId?.startsWith('drafts.'));
const publishedId = doc._id.replace(/^drafts\./, '');

// Studio structure tool deep link to this document.
const editHref = `/studio/structure/${doc._type};${publishedId}`;

const lastEditedIso = doc._updatedAt ?? '';
const lastEditedLabel = doc._updatedAt
  ? new Date(doc._updatedAt).toLocaleString('en-GB', {
      day: 'numeric',
      month: 'short',
      year: 'numeric',
      hour: '2-digit',
      minute: '2-digit',
    })
  : 'Unknown';
---

<aside
  class="preview-banner"
  role="status"
  aria-label="Preview environment"
  data-state="visible"
>
  <div class="preview-banner__inner">
    <span
      class="preview-banner__badge"
      data-variant={isDraft ? 'draft' : 'published'}
    >
      {isDraft ? 'Draft' : 'Published'}
    </span>
    <span class="preview-banner__label">Preview mode</span>
    <span class="preview-banner__meta">
      Last edited
      <time datetime={lastEditedIso}>{lastEditedLabel}</time>
    </span>
    <a class="preview-banner__edit" href={editHref}>Edit in Studio →</a>
    <button
      type="button"
      class="preview-banner__dismiss"
      aria-label="Dismiss preview banner"
      data-preview-banner-dismiss
    >
      ×
    </button>
  </div>
</aside>

<style>
  .preview-banner {
    position: fixed;
    inset-inline: 0;
    bottom: 0;
    z-index: 9999;
    background: oklch(0.2 0 0 / 0.92);
    color: white;
    font-size: 0.8125rem;
    line-height: 1.4;
    backdrop-filter: blur(8px);
    border-top: 1px solid oklch(1 0 0 / 0.1);
  }
  .preview-banner[data-state='hidden'] {
    display: none;
  }
  .preview-banner__inner {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    padding: 0.625rem 1rem;
    max-width: 1440px;
    margin: 0 auto;
    flex-wrap: wrap;
  }
  .preview-banner__badge {
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 0.125rem 0.5rem;
    border-radius: 9999px;
  }
  .preview-banner__badge[data-variant='draft'] {
    background: oklch(0.75 0.18 70);
    color: oklch(0.2 0.05 70);
  }
  .preview-banner__badge[data-variant='published'] {
    background: oklch(0.75 0.15 150);
    color: oklch(0.2 0.05 150);
  }
  .preview-banner__label {
    font-weight: 600;
  }
  .preview-banner__meta {
    color: oklch(1 0 0 / 0.7);
  }
  .preview-banner__meta time {
    color: white;
    font-variant-numeric: tabular-nums;
  }
  .preview-banner__edit {
    margin-inline-start: auto;
    color: white;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .preview-banner__edit:hover {
    color: oklch(0.85 0.15 220);
  }
  .preview-banner__dismiss {
    background: transparent;
    border: none;
    color: oklch(1 0 0 / 0.7);
    font-size: 1.25rem;
    line-height: 1;
    cursor: pointer;
    padding: 0 0.25rem;
  }
  .preview-banner__dismiss:hover {
    color: white;
  }
</style>

<script>
  const banner = document.querySelector<HTMLElement>('.preview-banner');
  const dismiss = document.querySelector<HTMLButtonElement>(
    '[data-preview-banner-dismiss]'
  );
  if (banner && dismiss) {
    dismiss.addEventListener('click', () => {
      banner.setAttribute('data-state', 'hidden');
    });
  }
</script>
