---
import type { DetailsIconsFeaturedImageProps } from './DetailsIconsFeaturedImage.types';
import Label from '@/components/Typography/Label/Label.astro';

type Props = DetailsIconsFeaturedImageProps;

const { eyebrow, heading, body, features, image, dark = false } = Astro.props;
---

<section class:list={[dark ? 'bg-brand-900' : 'bg-off-white', 'py-24']}>
  <div class="container">
    <!-- Top zone: two columns -->
    <div class="flex flex-col lg:flex-row gap-16">
      <!-- Left column: eyebrow, heading, body -->
      <div class="flex flex-col gap-5 flex-1 min-w-0">
        <Label
          size="sm"
          text={eyebrow}
          class={dark ? 'text-brand-300' : 'text-brand-700'}
        />
        <h2
          class:list={[
            'text-display-md font-semibold tracking-display-md',
            dark ? 'text-off-white' : 'text-brand-900',
          ]}
        >
          {heading}
        </h2>
        <p
          class:list={[
            'text-xl font-normal',
            dark ? 'text-brand-200' : 'text-brand-400',
          ]}
        >
          {body}
        </p>
      </div>

      <!-- Right column: vertical list of icon features -->
      <div class="flex flex-col gap-10 flex-1 min-w-0">
        {
          features.map((feature) => (
            <div class="flex items-start gap-4">
              <div
                class:list={[
                  'flex items-center justify-center rounded-[10px] size-12 shrink-0',
                  dark ? 'bg-brand-700' : 'bg-brand-50',
                ]}
              >
                <slot name={`icon-${feature.icon}`} />
              </div>
              <div class="flex flex-col gap-1">
                <h3
                  class:list={[
                    'text-md font-semibold',
                    dark ? 'text-off-white' : 'text-brand-900',
                  ]}
                >
                  {feature.heading}
                </h3>
                <p
                  class:list={[
                    'text-md font-normal',
                    dark ? 'text-brand-300' : 'text-brand-400',
                  ]}
                >
                  {feature.body}
                </p>
              </div>
            </div>
          ))
        }
      </div>
    </div>

    <!-- Bottom zone: full-width featured image -->
    <img
      src={image.src}
      alt={image.alt}
      class="w-full rounded-2xl object-cover mt-16 aspect-[1216/480]"
      loading="lazy"
    />
  </div>
</section>
