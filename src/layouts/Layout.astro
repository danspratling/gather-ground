---
import Footer from '@/components/Layout/Footer/Footer.astro';
import type { SocialPlatform } from '@/components/Layout/Footer/Footer.types';
import Header from '@/components/Layout/Header/Header.astro';
import PageHead from '@/components/PageHead/PageHead.astro';
import PreviewBanner from '@/components/PreviewBanner/PreviewBanner.astro';
import type { PreviewDoc } from '@/components/PreviewBanner/PreviewBanner.types';
import { VisualEditing } from '@sanity/astro/visual-editing';
import { loadQuery } from '@/lib/sanity';
import { siteSettingsQuery } from '@/lib/queries';
import '@/styles/global.css';

const visualEditingEnabled =
  import.meta.env.PUBLIC_SANITY_VISUAL_EDITING_ENABLED === 'true';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
  canonicalUrl?: string;
  previewDoc?: PreviewDoc;
}

interface SiteSettingsData {
  siteName?: string;
  siteDescription?: string;
  logo?: string;
  logoAlt?: string;
  primaryNav?: Array<{
    label: string;
    href?: string;
    menu?: Array<{ label: string; href: string; description?: string }>;
  }>;
  headerCtaLabel?: string;
  headerCtaHref?: string;
  footerDescription?: string;
  footerLinkGroups?: Array<{
    heading: string;
    links: Array<{ label: string; href: string }>;
  }>;
  socialLinks?: Array<{ platform: string; href: string; label: string }>;
  copyrightText?: string;
  footerLegalLinks?: Array<{ label: string; href: string }>;
  announcementBanner?: {
    enabled?: boolean;
    message?: string;
    ctaLabel?: string;
    ctaHref?: string;
    variant?: 'info' | 'warning' | 'success';
  };
}

const { title, description, ogImage, ogType, canonicalUrl, previewDoc } =
  Astro.props;

const { data: siteSettings } = await loadQuery<SiteSettingsData | null>({
  query: siteSettingsQuery,
});

const SUPPORTED_PLATFORMS = new Set<SocialPlatform>([
  'instagram',
  'facebook',
  'tiktok',
  'twitter',
  'linkedin',
]);

const defaultNavLinks = [
  {
    label: 'Shop',
    menu: [
      {
        label: 'Beef',
        href: '/shop/beef',
        description: 'Angus and Hereford, dry-aged.',
      },
      {
        label: 'Pork',
        href: '/shop/pork',
        description: 'Berkshire and Duroc, pasture-raised.',
      },
      {
        label: 'Chicken',
        href: '/shop/chicken',
        description: 'Freedom Ranger, slow-grown.',
      },
      { label: 'View all products', href: '/shop', iconTrailing: true },
    ],
  },
  {
    label: 'About us',
    menu: [
      {
        label: 'Our story',
        href: '/about',
        description: 'How Gather Ground began.',
      },
      {
        label: 'The farm',
        href: '/about/farm',
        description: 'Our land and animals.',
      },
      { label: 'Sustainability', href: '/about/sustainability' },
    ],
  },
  { label: 'Blog', href: '/blog' },
  { label: 'Contact', href: '/contact' },
];

const headerProps = {
  logoSrc: siteSettings?.logo ?? '/favicon.svg',
  logoAlt: siteSettings?.logoAlt ?? 'Gather Ground',
  navLinks: siteSettings?.primaryNav ?? defaultNavLinks,
  ctaLabel: siteSettings?.headerCtaLabel ?? 'Sign up',
  ctaHref: siteSettings?.headerCtaHref ?? '/signup',
  loginLabel: 'Log in',
  loginHref: '/login',
  accountHref: '/account',
  basketHref: '/cart',
  footerLinks: [
    { label: 'About us', href: '/about' },
    { label: 'Blog', href: '/blog' },
    { label: 'Privacy', href: '/privacy' },
    { label: 'Terms', href: '/terms' },
    { label: 'Contact', href: '/contact' },
    { label: 'Cookies', href: '/cookies' },
  ],
};

const footerProps = {
  logoSrc: siteSettings?.logo ?? '/favicon.svg',
  logoAlt: siteSettings?.logoAlt ?? 'Gather Ground',
  description:
    siteSettings?.footerDescription ??
    'Family farm in rural Iowa. We raise heritage breed animals on pasture year-round.',
  socialLinks: siteSettings?.socialLinks
    ? siteSettings.socialLinks
        .filter((l) => SUPPORTED_PLATFORMS.has(l.platform as SocialPlatform))
        .map((l) => ({
          platform: l.platform as SocialPlatform,
          href: l.href,
          label: l.label,
        }))
    : [
        {
          platform: 'instagram' as const,
          href: 'https://instagram.com',
          label: 'Instagram',
        },
        {
          platform: 'facebook' as const,
          href: 'https://facebook.com',
          label: 'Facebook',
        },
        {
          platform: 'tiktok' as const,
          href: 'https://tiktok.com',
          label: 'TikTok',
        },
      ],
  linkGroups: siteSettings?.footerLinkGroups ?? [
    {
      heading: 'Company',
      links: [
        { label: 'About', href: '/about' },
        { label: 'News', href: '/news' },
        { label: 'Shop', href: '/shop', badge: 'New' },
        { label: 'Contact', href: '/contact' },
      ],
    },
    {
      heading: 'Products',
      links: [
        { label: 'Beef', href: '/products/beef' },
        { label: 'Pork', href: '/products/pork' },
        { label: 'Chicken', href: '/products/chicken' },
        { label: 'Turkey', href: '/products/turkey' },
        { label: 'Eggs', href: '/products/eggs' },
      ],
    },
  ],
  newsletterHeading: 'Stay up to date',
  copyrightText:
    siteSettings?.copyrightText ??
    `© ${new Date().getFullYear()} Gather Ground`,
  legalLinks: siteSettings?.footerLegalLinks ?? [
    { label: 'Terms', href: '/terms' },
    { label: 'Privacy', href: '/privacy' },
    { label: 'Cookies', href: '/cookies' },
  ],
};
---

<html lang="en">
  <head>
    <PageHead
      title={title}
      description={description}
      ogImage={ogImage}
      ogType={ogType}
      canonicalUrl={canonicalUrl}
    >
      <slot name="head-extras" slot="head-extras" />
    </PageHead>
  </head>
  <body>
    {/* body-start: announcement banner, skip-to-content */}
    <slot name="body-start" />
    <Header {...headerProps} />
    <slot />
    <Footer {...footerProps} />
    {/* body-end: cookie banner, analytics */}
    <slot name="body-end" />
    <VisualEditing enabled={visualEditingEnabled} />
    {visualEditingEnabled && previewDoc && <PreviewBanner doc={previewDoc} />}
  </body>
</html>
