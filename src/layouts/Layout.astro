---
import Footer from '@/components/Layout/Footer/Footer.astro';
import Header from '@/components/Layout/Header/Header.astro';
import { VisualEditing } from '@sanity/astro/visual-editing';
import '@/styles/global.css';

const visualEditingEnabled =
  import.meta.env.PUBLIC_SANITY_VISUAL_EDITING_ENABLED === 'true';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
  canonicalUrl?: string;
}

const { title, description, ogImage, ogType, canonicalUrl } = Astro.props;

const footerProps = {
  logoSrc: '/favicon.svg',
  logoAlt: 'Gather Ground',
  description:
    'Family farm in rural Iowa. We raise heritage breed animals on pasture year-round.',
  socialLinks: [
    {
      platform: 'instagram' as const,
      href: 'https://instagram.com',
      label: 'Instagram',
    },
    {
      platform: 'facebook' as const,
      href: 'https://facebook.com',
      label: 'Facebook',
    },
    {
      platform: 'tiktok' as const,
      href: 'https://tiktok.com',
      label: 'TikTok',
    },
  ],
  linkGroups: [
    {
      heading: 'Company',
      links: [
        { label: 'About', href: '/about' },
        { label: 'News', href: '/news' },
        { label: 'Shop', href: '/shop', badge: 'New' },
        { label: 'Contact', href: '/contact' },
      ],
    },
    {
      heading: 'Products',
      links: [
        { label: 'Beef', href: '/products/beef' },
        { label: 'Pork', href: '/products/pork' },
        { label: 'Chicken', href: '/products/chicken' },
        { label: 'Turkey', href: '/products/turkey' },
        { label: 'Eggs', href: '/products/eggs' },
      ],
    },
  ],
  newsletterHeading: 'Stay up to date',
  copyrightText: `© ${new Date().getFullYear()} Gather Ground`,
  legalLinks: [
    { label: 'Terms', href: '/terms' },
    { label: 'Privacy', href: '/privacy' },
    { label: 'Cookies', href: '/cookies' },
  ],
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {ogType && <meta property="og:type" content={ogType} />}
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
  </head>
  <body>
    <Header
      logoSrc="/favicon.svg"
      logoAlt="Gather Ground"
      navLinks={[
        {
          label: 'Shop',
          menu: [
            {
              label: 'Beef',
              href: '/shop/beef',
              description: 'Angus and Hereford, dry-aged.',
            },
            {
              label: 'Pork',
              href: '/shop/pork',
              description: 'Berkshire and Duroc, pasture-raised.',
            },
            {
              label: 'Chicken',
              href: '/shop/chicken',
              description: 'Freedom Ranger, slow-grown.',
            },
            { label: 'View all products', href: '/shop', iconTrailing: true },
          ],
        },
        {
          label: 'About us',
          menu: [
            {
              label: 'Our story',
              href: '/about',
              description: 'How Gather Ground began.',
            },
            {
              label: 'The farm',
              href: '/about/farm',
              description: 'Our land and animals.',
            },
            { label: 'Sustainability', href: '/about/sustainability' },
          ],
        },
        { label: 'Blog', href: '/blog' },
        { label: 'Contact', href: '/contact' },
      ]}
      ctaLabel="Sign up"
      ctaHref="/signup"
      loginLabel="Log in"
      loginHref="/login"
      accountHref="/account"
      basketHref="/cart"
      footerLinks={[
        { label: 'About us', href: '/about' },
        { label: 'Blog', href: '/blog' },
        { label: 'Privacy', href: '/privacy' },
        { label: 'Terms', href: '/terms' },
        { label: 'Contact', href: '/contact' },
        { label: 'Cookies', href: '/cookies' },
      ]}
    />
    <slot />
    <Footer {...footerProps} />
    <VisualEditing enabled={visualEditingEnabled} />
  </body>
</html>
