---
import Footer from '@/components/Footer.astro';
import '@/styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;

const footerProps = {
  logoSrc: '/favicon.svg',
  logoAlt: 'Gather Ground',
  description:
    'Family farm in rural Iowa. We raise heritage breed animals on pasture year-round.',
  socialLinks: [
    {
      platform: 'instagram' as const,
      href: 'https://instagram.com',
      label: 'Instagram',
    },
    {
      platform: 'facebook' as const,
      href: 'https://facebook.com',
      label: 'Facebook',
    },
    {
      platform: 'tiktok' as const,
      href: 'https://tiktok.com',
      label: 'TikTok',
    },
  ],
  linkGroups: [
    {
      heading: 'Company',
      links: [
        { label: 'About', href: '/about' },
        { label: 'News', href: '/news' },
        { label: 'Shop', href: '/shop', badge: 'New' },
        { label: 'Contact', href: '/contact' },
      ],
    },
    {
      heading: 'Products',
      links: [
        { label: 'Beef', href: '/products/beef' },
        { label: 'Pork', href: '/products/pork' },
        { label: 'Chicken', href: '/products/chicken' },
        { label: 'Turkey', href: '/products/turkey' },
        { label: 'Eggs', href: '/products/eggs' },
      ],
    },
  ],
  newsletterHeading: 'Stay up to date',
  copyrightText: `© ${new Date().getFullYear()} Gather Ground`,
  legalLinks: [
    { label: 'Terms', href: '/terms' },
    { label: 'Privacy', href: '/privacy' },
    { label: 'Cookies', href: '/cookies' },
  ],
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <Footer {...footerProps} />
  </body>
</html>
