---
import AnnouncementBanner from '@/components/AnnouncementBanner/AnnouncementBanner.astro';
import AccountCartPanel from '@/components/AccountCartPanel/AccountCartPanel';
import CartTrigger from '@/components/CartTrigger/CartTrigger';
import CartDrawer from '@/components/CartDrawer/CartDrawer';
import CookieBanner from '@/components/CookieBanner/CookieBanner';
import Clarity from '@/components/Analytics/Clarity.astro';
import Footer from '@/components/Layout/Footer/Footer.astro';
import type { SocialPlatform } from '@/components/Layout/Footer/Footer.types';
import Header from '@/components/Layout/Header/Header.astro';
import type { HeaderProps } from '@/components/Layout/Header/Header.types';
import PageHead from '@/components/PageHead/PageHead.astro';
import PreviewBanner from '@/components/PreviewBanner/PreviewBanner.astro';
import type { PreviewDoc } from '@/components/PreviewBanner/PreviewBanner.types';
import StructuredData from '@/components/StructuredData/StructuredData.astro';
import { VisualEditing } from '@sanity/astro/visual-editing';
import { stegaClean } from '@sanity/client/stega';
import { loadQuery } from '@/lib/sanity';
import { siteSettingsQuery } from '@/lib/queries';
import { resolveSanityLink } from '@/lib/sanityLink';
import { buildOrganization, buildWebPage } from '@/lib/structuredData';
import { isCommerceEnabled } from '@/lib/commerce/featureFlag';
import { isVisualEditingEnabled as visualEditingEnabled } from '@/lib/visualEditing';
import '@/styles/global.css';

interface Props {
  title: string;
  metaTitle?: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
  canonicalUrl?: string;
  previewDoc?: PreviewDoc;
  showRssFeed?: boolean;
}

interface SanityLinkData {
  type?: 'url' | 'internal' | 'email' | 'anchor';
  url?: string;
  internalLink?: { slug?: { current?: string } };
  email?: string;
  anchor?: string;
}

interface SiteSettingsData {
  siteName?: string;
  siteDescription?: string;
  logo?: string;
  logoAlt?: string;
  favicon?: string;
  primaryNav?: Array<{
    label: string;
    link?: SanityLinkData;
    menu?: Array<{ label: string; link: SanityLinkData; description?: string }>;
  }>;
  headerCtaLabel?: string;
  headerCtaLink?: SanityLinkData;
  footerDescription?: string;
  footerLinkGroups?: Array<{
    heading: string;
    links: Array<{ label: string; link: SanityLinkData }>;
  }>;
  socialLinks?: Array<{ platform: string; url: string; label: string }>;
  copyrightText?: string;
  footerLegalLinks?: Array<{ label: string; link: SanityLinkData }>;
  announcementBanner?: {
    enabled?: boolean;
    message?: string;
    ctaLabel?: string;
    ctaLink?: SanityLinkData;
    variant?: 'info' | 'warning' | 'success';
  };
  defaultMetaTitle?: string;
  defaultMetaDescription?: string;
  defaultOgImage?: string;
}

const {
  title,
  metaTitle,
  description,
  ogImage,
  ogType,
  canonicalUrl,
  previewDoc,
  showRssFeed,
} = Astro.props;

const { data: siteSettings } = await loadQuery<SiteSettingsData | null>({
  query: siteSettingsQuery,
});

// ── SEO fallback chain ──────────────────────────────────────────────
const siteName = siteSettings?.siteName ?? 'Gather Ground';
const seoTitle = metaTitle || `${title} | ${siteName}`;
const seoDescription =
  description ||
  siteSettings?.defaultMetaDescription ||
  siteSettings?.siteDescription;
const seoOgImage = ogImage || siteSettings?.defaultOgImage;

const siteUrl = (Astro.site ?? new URL(Astro.url.origin))
  .toString()
  .replace(/\/$/, '');
const organizationSD = buildOrganization(
  {
    siteName,
    siteDescription: siteSettings?.siteDescription,
    logo: siteSettings?.logo,
  },
  siteUrl
);
const resolvedPageUrl =
  canonicalUrl || new URL(Astro.url.pathname, siteUrl).toString();
const commerceEnabled = isCommerceEnabled();
const customer = Astro.locals.customer;
const webPageSD = buildWebPage({
  title: seoTitle,
  description: seoDescription,
  url: resolvedPageUrl,
});

const SUPPORTED_PLATFORMS = new Set<SocialPlatform>([
  'instagram',
  'facebook',
  'tiktok',
  'twitter',
  'linkedin',
]);

const headerProps: HeaderProps = {
  logoSrc: siteSettings?.logo ?? '/favicon.svg',
  logoAlt: siteSettings?.logoAlt ?? 'Gather Ground',
  navLinks: siteSettings?.primaryNav
    ? (siteSettings.primaryNav.flatMap((item): HeaderProps['navLinks'] => {
        const menu = item.menu
          ?.map((m) => {
            const href = resolveSanityLink(m.link);
            return href
              ? { label: m.label, href, description: m.description }
              : null;
          })
          .filter(
            (
              menuItem
            ): menuItem is {
              label: string;
              href: string;
              description: string | undefined;
            } => menuItem !== null
          );

        if (menu && menu.length > 0) {
          return [{ label: item.label, menu }];
        }

        const href = item.link ? resolveSanityLink(item.link) : '';
        return href ? [{ label: item.label, href }] : [];
      }) as HeaderProps['navLinks'])
    : [],
  footerLinks: siteSettings?.footerLegalLinks
    ? siteSettings.footerLegalLinks
        .map((l) => ({
          label: l.label,
          href: resolveSanityLink(l.link),
        }))
        .filter((l) => l.href)
    : [],
};

const footerProps = {
  logoSrc: siteSettings?.logo ?? '/favicon.svg',
  logoAlt: siteSettings?.logoAlt ?? 'Gather Ground',
  description: siteSettings?.footerDescription ?? '',
  socialLinks: siteSettings?.socialLinks
    ? siteSettings.socialLinks
        .map((l) => ({
          // Visual Editing stega encoding appends invisible Unicode characters
          // to every string, which breaks the SUPPORTED_PLATFORMS Set lookup
          // below — clean the discriminator before using it for control flow.
          platform: stegaClean(l.platform) as SocialPlatform,
          href: l.url,
          label: l.label,
        }))
        .filter((l) => SUPPORTED_PLATFORMS.has(l.platform))
    : [],
  linkGroups: siteSettings?.footerLinkGroups
    ? siteSettings.footerLinkGroups.map((group) => ({
        heading: group.heading,
        links: group.links
          .map((l) => ({
            label: l.label,
            href: resolveSanityLink(l.link),
          }))
          .filter((l) => l.href),
      }))
    : [],
  newsletterHeading: 'Stay up to date',
  copyrightText:
    siteSettings?.copyrightText ??
    `© ${new Date().getFullYear()} Gather Ground`,
  legalLinks: siteSettings?.footerLegalLinks
    ? siteSettings.footerLegalLinks
        .map((l) => ({
          label: l.label,
          href: resolveSanityLink(l.link),
        }))
        .filter((l) => l.href)
    : [],
};
---

<html lang="en">
  <head>
    <PageHead
      title={seoTitle}
      description={seoDescription}
      ogImage={seoOgImage}
      ogType={ogType}
      canonicalUrl={canonicalUrl}
      favicon={siteSettings?.favicon}
      showRssFeed={showRssFeed}
    >
      <StructuredData data={organizationSD} slot="head-extras" />
      <StructuredData data={webPageSD} slot="head-extras" />
      <slot name="head-extras" slot="head-extras" />
    </PageHead>
  </head>
  <body>
    {/* body-start: announcement banner, skip-to-content */}
    <slot name="body-start" />
    {
      siteSettings?.announcementBanner?.enabled &&
        siteSettings.announcementBanner.message && (
          <AnnouncementBanner
            message={siteSettings.announcementBanner.message}
            ctaLabel={siteSettings.announcementBanner.ctaLabel}
            ctaHref={
              siteSettings.announcementBanner.ctaLink
                ? resolveSanityLink(siteSettings.announcementBanner.ctaLink)
                : undefined
            }
            variant={siteSettings.announcementBanner.variant}
          />
        )
    }
    <Header {...headerProps} showCommerceSlots={commerceEnabled}>
      {
        commerceEnabled && customer && (
          <AccountCartPanel
            slot="commerce-account"
            client:idle
            customer={customer}
          />
        )
      }
      {commerceEnabled && <CartTrigger slot="commerce-cart" client:idle />}
    </Header>
    {
      commerceEnabled && (
        <>
          {/*
            Buffer cart:open events that fire before CartDrawer's useEffect
            has registered its window listener. The script also intercepts
            clicks on the CartTrigger button natively so the drawer opens
            even if React hasn't hydrated CartTrigger yet (concurrent-mode
            hydration race condition in Playwright e2e tests).
            CartDrawer reads __pendingCartOpen on mount and opens immediately.
          */}
          <script is:inline>
            window.__pendingCartOpen = false;
            // Buffer any cart:open events that arrive before CartDrawer mounts.
            window.addEventListener('cart:open', function () {
              window.__pendingCartOpen = true;
            });
            // Intercept native clicks on the CartTrigger button so the cart
            // opens even before React attaches its onClick handler.
            (function () {
              function setup() {
                document.addEventListener('click', function (e) {
                  var el = e.target;
                  while (el && el.tagName) {
                    if (
                      el.tagName === 'BUTTON' &&
                      typeof el.getAttribute === 'function' &&
                      (el.getAttribute('aria-label') || '').indexOf(
                        'Open cart'
                      ) === 0
                    ) {
                      window.__pendingCartOpen = true;
                      window.dispatchEvent(new CustomEvent('cart:open'));
                      return;
                    }
                    el = el.parentElement;
                  }
                });
              }
              if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', setup);
              } else {
                setup();
              }
            })();
          </script>
          <CartDrawer client:idle />
        </>
      )
    }
    <slot />
    <Footer {...footerProps} />
    {/* body-end: cookie banner, analytics */}
    <slot name="body-end" />
    <CookieBanner client:load />
    {
      import.meta.env.PUBLIC_CLARITY_PROJECT_ID && (
        <Clarity projectId={import.meta.env.PUBLIC_CLARITY_PROJECT_ID} />
      )
    }
    <VisualEditing enabled={visualEditingEnabled} />
    {visualEditingEnabled && previewDoc && <PreviewBanner doc={previewDoc} />}
  </body>
</html>
