---
export const prerender = false;
import Layout from '@/layouts/Layout.astro';
import AccountLayout from '@/components/AccountLayout/AccountLayout.astro';
import OrdersList from '@/components/OrdersList/OrdersList.astro';
import type { CLOrderStatus } from '@/components/OrderStatusBadge/OrderStatusBadge.types';
import type { OrderListItemProps } from '@/components/OrderListItem/OrderListItem.types';

const page = Math.max(
  1,
  parseInt(Astro.url.searchParams.get('page') ?? '1', 10)
);

const apiUrl = new URL(`/api/commerce/account/orders?page=${page}`, Astro.url)
  .href;
const response = await fetch(apiUrl, {
  headers: { cookie: Astro.request.headers.get('cookie') ?? '' },
});

function mapStatus(status: string): CLOrderStatus {
  switch (status) {
    case 'delivered':
      return 'fulfilled';
    case 'cancelled':
      return 'cancelled';
    default:
      return 'placed';
  }
}

let orders: OrderListItemProps[] = [];
if (response.ok) {
  const data = await response.json();
  if (data.success && Array.isArray(data.orders)) {
    orders = data.orders.map(
      (o: {
        id: string;
        number: string;
        status: string;
        placedAt: string;
        total: { formatted: string };
        lineItemCount: number;
      }) => ({
        id: o.id,
        orderNumber: o.number,
        placedAt: o.placedAt,
        status: mapStatus(o.status),
        itemCount: o.lineItemCount,
        totalFormatted: o.total.formatted,
      })
    );
  }
}

const customer = Astro.locals.customer!;
---

<Layout title="My Orders" description="Your order history.">
  <meta name="robots" content="noindex" slot="head-extras" />
  <AccountLayout
    customerName={customer.firstName}
    pathname={Astro.url.pathname}
  >
    <div class="space-y-6">
      <h1 class="text-2xl font-semibold text-brand-900">Orders</h1>
      <OrdersList orders={orders} />
    </div>
  </AccountLayout>
</Layout>
