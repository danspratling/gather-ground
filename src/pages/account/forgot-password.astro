---
export const prerender = false;

import Layout from '@/layouts/Layout.astro';
import ForgotPasswordForm from '@/components/Forms/ForgotPasswordForm/ForgotPasswordForm';

const customer = Astro.locals.customer;
if (customer) {
  return Astro.redirect('/account', 302);
}
---

<Layout
  title="Forgot password"
  description="Reset your Gather Ground account password."
>
  <meta name="robots" content="noindex" slot="head-extras" />
  <main class="flex min-h-screen items-center justify-center px-4 py-16">
    <div class="w-full max-w-md">
      <h1 class="mb-8 text-display-xs font-bold text-brand-900">
        Reset your password
      </h1>
      <p class="mb-6 text-sm text-brand-600">
        Enter your email address and we'll send you a link to reset your
        password.
      </p>
      <ForgotPasswordForm client:load loginHref="/account/login" />
    </div>
  </main>
</Layout>
