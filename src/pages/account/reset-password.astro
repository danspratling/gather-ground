---
export const prerender = false;

import Layout from '@/layouts/Layout.astro';
import ResetPasswordForm from '@/components/Forms/ResetPasswordForm/ResetPasswordForm';

// Pass the token server-side so the component doesn't need to read the URL
// on mount — eliminates the brief "invalid token" flash for users arriving
// with a valid ?token= in the link.
const token = Astro.url.searchParams.get('token') ?? undefined;
---

<Layout
  title="Reset password"
  description="Set a new password for your Gather Ground account."
>
  <meta name="robots" content="noindex" slot="head-extras" />
  <main class="flex min-h-screen items-center justify-center px-4 py-16">
    <div class="w-full max-w-md">
      <h1 class="mb-8 text-display-xs font-bold text-brand-900">
        Set new password
      </h1>
      <ResetPasswordForm client:load token={token} loginHref="/account/login" />
    </div>
  </main>
</Layout>
