---
import Layout from '@/layouts/Layout.astro';
import RichText from '@/components/RichText/RichText.astro';
import { loadQuery } from '@/lib/sanity';
import { legalPageQuery } from '@/lib/queries';

const { data: page } = await loadQuery<{
  _id: string;
  title: string;
  slug: string;
  body: Array<Record<string, unknown>>;
} | null>({
  query: legalPageQuery,
  params: { slug: 'privacy' },
});
---

<Layout title={page?.title ?? 'Privacy Policy'} description="Our privacy policy">
  <main class="container mx-auto max-w-3xl px-4 py-16">
    <h1 class="mb-8 text-display-sm font-bold text-gray-950">
      {page?.title ?? 'Privacy Policy'}
    </h1>
    {page?.body ? (
      <RichText content={page.body} />
    ) : (
      <div class="prose max-w-none">
        <!-- TODO: Replace with actual Privacy Policy text. Create a 'Legal Page' document in Sanity CMS at /studio with slug 'privacy'. -->
        <p class="text-gray-700">
          Our privacy policy is currently being updated. Please check back soon.
        </p>
      </div>
    )}
  </main>
</Layout>
