---
import Layout from '@/layouts/Layout.astro';
---

<Layout
  title="Page Not Found — Gather Ground"
  description="The page you're looking for doesn't exist."
>
  <main
    class="container mx-auto flex flex-col items-center justify-center px-4 py-32 text-center"
  >
    <p class="text-base font-semibold text-brand-500">404</p>
    <h1 class="mt-4 text-display-md font-bold text-gray-950">Page not found</h1>
    <p class="mt-4 max-w-md text-base text-gray-700">
      Sorry, we couldn't find the page you're looking for. It may have been
      moved or deleted.
    </p>
    <a
      href="/"
      class="mt-8 rounded-full bg-brand-700 px-6 py-2.5 text-base font-semibold text-brand-25 hover:bg-brand-600"
    >
      Back to home
    </a>
  </main>
</Layout>
