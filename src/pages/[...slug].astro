---
import Layout from '@/layouts/Layout.astro';
import SectionMapper from '@/templates/SectionMapper.astro';
import { loadQuery } from '@/lib/sanity';
import {
  allPageSlugsQuery,
  pageBySlugQuery,
  instagramWidgetQuery,
} from '@/lib/queries';

export async function getStaticPaths() {
  const { data: pages } = await loadQuery<Array<{ slug: string }>>({
    query: allPageSlugsQuery,
  });

  return pages.map((page) => ({
    params: { slug: page.slug === '/' ? undefined : page.slug },
  }));
}

const { slug } = Astro.params;
const pageSlug = slug ?? '/';

const [{ data: page }, { data: widgets }] = await Promise.all([
  loadQuery<{
    _id: string;
    _type: string;
    _updatedAt?: string;
    _originalId?: string;
    title: string;
    slug: string;
    metaTitle?: string;
    metaDescription?: string;
    ogImage?: string;
    autoDescription?: string;
    autoOgImage?: string;
    body: Array<Record<string, unknown> & { _type: string; _key: string }>;
  } | null>({
    query: pageBySlugQuery,
    params: { slug: pageSlug },
  }),
  loadQuery<{ instagramHandle?: string; beholdFeedId?: string } | null>({
    query: instagramWidgetQuery,
  }),
]);

// Slug not found (e.g. on-demand SSR for unknown URL, or draft/published
// mismatch during Visual Editing). Render the 404 page with a real 404
// status — Astro.rewrite serves the /404 route's content at the current
// URL without issuing a redirect, and Astro.response.status sets the
// HTTP status code returned to the client.
if (!page) {
  Astro.response.status = 404;
  return Astro.rewrite('/404');
}
---

<Layout
  title={page.title}
  metaTitle={page.metaTitle}
  description={page.metaDescription || page.autoDescription}
  ogImage={page.ogImage || page.autoOgImage}
  previewDoc={{
    _id: page._id,
    _type: page._type,
    _updatedAt: page._updatedAt,
    _originalId: page._originalId,
  }}
>
  <main>
    <SectionMapper
      sections={page.body ?? []}
      instagramHandle={widgets?.instagramHandle}
      beholdFeedId={widgets?.beholdFeedId}
    />
  </main>
</Layout>
