---
import Layout from '@/layouts/Layout.astro';
import SectionMapper from '@/templates/SectionMapper.astro';
import { loadQuery } from '@/lib/sanity';
import { allPageSlugsQuery, pageBySlugQuery } from '@/lib/queries';

export async function getStaticPaths() {
  const { data: pages } = await loadQuery<Array<{ slug: string }>>({
    query: allPageSlugsQuery,
  });

  return pages.map((page) => ({
    params: { slug: page.slug === '/' ? undefined : page.slug },
  }));
}

const { slug } = Astro.params;
const pageSlug = slug ?? '/';

const { data: page } = await loadQuery<{
  _id: string;
  _type: string;
  _updatedAt?: string;
  _originalId?: string;
  title: string;
  slug: string;
  metaDescription?: string;
  ogImage?: string;
  body: Array<Record<string, unknown> & { _type: string; _key: string }>;
}>({
  query: pageBySlugQuery,
  params: { slug: pageSlug },
});
---

<Layout
  title={page.title}
  description={page.metaDescription}
  ogImage={page.ogImage}
  previewDoc={{
    _id: page._id,
    _type: page._type,
    _updatedAt: page._updatedAt,
    _originalId: page._originalId,
  }}
>
  <main>
    <SectionMapper sections={page.body ?? []} />
  </main>
</Layout>
