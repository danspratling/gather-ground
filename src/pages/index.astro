---
import { getStoryblokApi } from '@storyblok/astro';
import Layout from '@/layouts/Layout.astro';
import HeroSection from '@/components/HeroSection/HeroSection.astro';
import ProductsSection from '@/components/ProductsSection/ProductsSection.astro';
import TestimonialsSection from '@/components/TestimonialsSection/TestimonialsSection';
import FaqSection from '@/components/FaqSection/FaqSection.astro';
import BlogSection from '@/components/BlogSection/BlogSection.astro';
import type { CallToActionProps } from '@/components/CallToAction/CallToAction.types';

const storyblokApi = getStoryblokApi();
const { data } = await storyblokApi.get('cdn/stories/home', {
  version: import.meta.env.DEV ? 'draft' : 'published',
});

// Storyblok blok fields are untyped at runtime — no generated schema types available.
type SbBlok = Record<string, any>;

const bloks: SbBlok[] = data?.story?.content?.body ?? [];

function mapCta(ctaBloks: SbBlok[]): CallToActionProps | undefined {
  const b: SbBlok | undefined = ctaBloks?.[0];
  if (!b) return undefined;
  const avatarBloks: SbBlok[] = b.avatars ?? [];
  return {
    heading: b.heading,
    body: b.body,
    primaryButton: {
      label: b.primary_button_label,
      href: b.primary_button_href,
      variant: b.primary_button_variant ?? 'default',
      size: 'md',
    },
    secondaryButton: b.secondary_button_label
      ? {
          label: b.secondary_button_label,
          href: b.secondary_button_href,
          variant: 'outline',
          size: 'md',
        }
      : undefined,
    avatarGroup:
      avatarBloks.length > 0
        ? {
            avatars: avatarBloks.map((a: SbBlok) => ({
              src: a.src?.filename ?? '',
              alt: a.alt ?? '',
            })),
          }
        : undefined,
  };
}
---

<Layout title="Gather Ground">
  <main>
    {
      bloks.map((blok) => {
        if (blok.component === 'hero_section') {
          return (
            <HeroSection
              headline={blok.headline}
              subCopy={blok.sub_copy}
              primaryCta={{
                label: blok.primary_cta_label,
                href: blok.primary_cta_href,
              }}
              secondaryCta={{
                label: blok.secondary_cta_label,
                href: blok.secondary_cta_href,
              }}
              image={{
                src: blok.image?.filename ?? '',
                alt: blok.image_alt ?? '',
              }}
            />
          );
        }
        if (
          blok.component === 'products_section_cards' ||
          blok.component === 'products_section_carousel'
        ) {
          return (
            <ProductsSection
              variant={
                blok.component === 'products_section_cards'
                  ? 'cards'
                  : 'carousel'
              }
              eyebrow={blok.eyebrow ?? ''}
              heading={blok.heading}
              subCopy={blok.sub_copy}
              products={(blok.products ?? []).map((p: SbBlok) => ({
                image: p.image?.filename ?? '',
                imageAlt: p.image_alt ?? '',
                title: p.title,
                description: p.description,
                href: p.href,
              }))}
            />
          );
        }
        if (blok.component === 'testimonials_section') {
          return (
            <TestimonialsSection
              client:visible
              heading={blok.heading}
              subCopy={blok.sub_copy}
              testimonials={(blok.testimonials ?? []).map((t: SbBlok) => ({
                quote: t.quote,
                platform: t.platform || undefined,
                author: {
                  src: t.author_src?.filename ?? '',
                  alt: t.author_alt ?? '',
                  name: t.author_name,
                  secondary: t.author_secondary || undefined,
                  secondaryIsHandle: t.author_secondary_is_handle ?? false,
                  size: 'md' as const,
                },
              }))}
            />
          );
        }
        if (blok.component === 'faq_section') {
          return (
            <FaqSection
              heading={blok.heading}
              subCopy={blok.sub_copy ?? ''}
              items={(blok.items ?? []).map((item: SbBlok) => ({
                question: item.question,
                answer: item.answer,
              }))}
              cta={mapCta(blok.cta)}
            />
          );
        }
        if (blok.component === 'blog_section') {
          return (
            <BlogSection
              eyebrow={blok.eyebrow ?? ''}
              heading={blok.heading}
              subCopy={blok.sub_copy ?? ''}
              viewAllHref={blok.view_all_href}
              viewAllLabel={blok.view_all_label}
              posts={(blok.posts ?? []).map((p: SbBlok) => ({
                image: p.image?.filename ?? '',
                imageAlt: p.image_alt ?? '',
                title: p.title,
                excerpt: p.excerpt,
                date: p.date,
                authorName: p.author_name,
                authorImage: p.author_image?.filename ?? '',
                authorImageAlt: p.author_image_alt ?? '',
                href: p.href,
              }))}
            />
          );
        }
        return null;
      })
    }
  </main>
</Layout>
