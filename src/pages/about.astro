---
import Layout from '@/layouts/Layout.astro';
import SectionMapper from '@/templates/SectionMapper.astro';
import { loadQuery } from '@/lib/sanity';
import { pageBySlugQuery } from '@/lib/queries';

const { data: page } = await loadQuery<{
  _id: string;
  _type: string;
  _updatedAt?: string;
  _originalId?: string;
  title: string;
  slug: string;
  body: Array<Record<string, unknown> & { _type: string; _key: string }>;
} | null>({
  query: pageBySlugQuery,
  params: { slug: 'about' },
});
---

<Layout
  title={page?.title ?? 'About Us — Gather Ground'}
  description="Learn about Gather Ground farm — our story, our animals, and our commitment to sustainable farming."
  previewDoc={page
    ? {
        _id: page._id,
        _type: page._type,
        _updatedAt: page._updatedAt,
        _originalId: page._originalId,
      }
    : undefined}
>
  {page ? (
    <SectionMapper sections={page.body} />
  ) : (
    <main class="container mx-auto max-w-3xl px-4 py-16">
      <!-- TODO: Add About page content in Sanity CMS at /studio. Create a 'Page' document with slug 'about' and add your content sections. -->
      <h1 class="mb-6 text-display-md font-bold text-gray-950">About Us</h1>
      <p class="text-base text-gray-700">
        We're working on our About page. Check back soon, or visit us at the farm!
      </p>
    </main>
  )}
</Layout>
