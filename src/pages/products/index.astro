---
import Layout from '@/layouts/Layout.astro';
import ProductCard from '@/components/ProductCard/ProductCard.astro';
import { loadQuery } from '@/lib/sanity';
import { allProductsQuery } from '@/lib/queries';
import { sanityImageSrc, sanityImageAlt } from '@/lib/sanityImage';

const { data: rawProducts } = await loadQuery<
  Array<{
    _id: string;
    title: string;
    slug: string;
    image?: { asset?: { _ref?: string; _id?: string }; alt?: string };
    metaDescription?: string;
  }>
>({ query: allProductsQuery });

const products = (rawProducts ?? []).map((product) => ({
  title: product.title,
  href: `/products/${product.slug}`,
  image: sanityImageSrc(
    product.image as { asset?: { _ref?: string; _id?: string } },
    { width: 600, quality: 80 }
  ),
  imageAlt: sanityImageAlt(product.image, product.title),
  description: product.metaDescription,
}));
---

<Layout title="Shop">
  <main>
    <section class="container py-16">
      <h1
        class="mb-10 text-display-md font-semibold tracking-display-md text-brand-900"
      >
        Shop
      </h1>
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          products.map((product) => (
            <ProductCard
              variant="commerce"
              title={product.title}
              href={product.href}
              image={product.image}
              imageAlt={product.imageAlt}
              description={product.description}
            />
          ))
        }
      </div>
    </section>
  </main>
</Layout>
