---
import Layout from '@/layouts/Layout.astro';
import SectionMapper from '@/templates/SectionMapper.astro';
import { loadQuery } from '@/lib/sanity';
import { productPageQuery } from '@/lib/queries';

const { data: page } = await loadQuery<{
  _id: string;
  _type: string;
  _updatedAt?: string;
  _originalId?: string;
  title: string;
  body: Array<Record<string, unknown> & { _type: string; _key: string }>;
} | null>({
  query: productPageQuery,
});
---

<Layout
  title={page?.title ?? 'Products'}
  previewDoc={page
    ? {
        _id: page._id,
        _type: page._type,
        _updatedAt: page._updatedAt,
        _originalId: page._originalId,
      }
    : undefined}
>
  <main>
    <SectionMapper sections={page?.body ?? []} />
  </main>
</Layout>
