---
import Layout from '@/layouts/Layout.astro';
import SectionMapper from '@/templates/SectionMapper.astro';
import { loadQuery } from '@/lib/sanity';
import { allProductSlugsQuery, productBySlugQuery } from '@/lib/queries';

export async function getStaticPaths() {
  const { data: products } = await loadQuery<Array<{ slug: string }>>({
    query: allProductSlugsQuery,
  });

  return products.map((product) => ({
    params: { slug: product.slug },
  }));
}

const { slug } = Astro.params;

const { data: page } = await loadQuery<{
  _id: string;
  _type: string;
  _updatedAt?: string;
  _originalId?: string;
  title: string;
  slug: string;
  metaTitle?: string;
  metaDescription?: string;
  ogImage?: string;
  autoDescription?: string;
  autoOgImage?: string;
  body: Array<Record<string, unknown> & { _type: string; _key: string }>;
} | null>({
  query: productBySlugQuery,
  params: { slug },
});

if (!page) {
  return Astro.redirect('/products');
}
---

<Layout
  title={page.title}
  metaTitle={page.metaTitle}
  description={page.metaDescription || page.autoDescription}
  ogImage={page.ogImage || page.autoOgImage}
  previewDoc={{
    _id: page._id,
    _type: page._type,
    _updatedAt: page._updatedAt,
    _originalId: page._originalId,
  }}
>
  <main>
    <SectionMapper sections={page.body ?? []} />
  </main>
</Layout>
