---
import type { Option, Variant, InventoryStatus } from '@/lib/commerce/types';
import Layout from '@/layouts/Layout.astro';
import SectionMapper from '@/templates/SectionMapper.astro';
import ProductDetail from '@/components/ProductDetail/ProductDetail';
import SectionDivider from '@/components/SectionDivider/SectionDivider.astro';
import { isCommerceEnabled } from '@/lib/commerce/featureFlag';
import { loadQuery } from '@/lib/sanity';
import {
  allProductSlugsQuery,
  productBySlugQuery,
  instagramWidgetQuery,
} from '@/lib/queries';
import { sanityImageSrc, sanityImageAlt } from '@/lib/sanityImage';

export async function getStaticPaths() {
  const { data: products } = await loadQuery<Array<{ slug: string }>>({
    query: allProductSlugsQuery,
  });

  return products.map((product) => ({
    params: { slug: product.slug },
  }));
}

const { slug } = Astro.params;

const [{ data: page }, { data: widgets }] = await Promise.all([
  loadQuery<{
    _id: string;
    _type: string;
    _updatedAt?: string;
    _originalId?: string;
    title: string;
    slug: string;
    metaTitle?: string;
    metaDescription?: string;
    ogImage?: string;
    autoDescription?: string;
    autoOgImage?: string;
    featuredImage?: {
      asset?: { _ref?: string; _id?: string; url?: string };
      alt?: string;
    };
    gallery?: Array<{
      url: string;
      alt?: string;
    }>;
    options?: Array<{ name: string; values: string[] }>;
    variants?: Array<{
      _id: string;
      sku: string;
      optionValues: Array<{ optionName: string; value: string }>;
      price: { amount: number; currency: string };
      compareAtPrice?: { amount: number; currency: string };
      weight?: number;
      inventoryStatus?: InventoryStatus;
    }>;
    defaultVariant?: { _id: string; sku: string };
    commerceEnabled?: boolean;
    body: Array<Record<string, unknown> & { _type: string; _key: string }>;
  } | null>({
    query: productBySlugQuery,
    params: { slug },
  }),
  loadQuery<{ instagramHandle?: string; beholdFeedId?: string } | null>({
    query: instagramWidgetQuery,
  }),
]);

if (!page) {
  return Astro.redirect('/products');
}

const commerceEnabled = isCommerceEnabled();

const productImages = [
  ...(page.featuredImage
    ? [
        {
          url: sanityImageSrc(
            page.featuredImage as { asset?: { _ref?: string; _id?: string } },
            { width: 800, quality: 85 }
          ),
          altText: sanityImageAlt(page.featuredImage, page.title),
        },
      ]
    : []),
  ...(page.gallery ?? []).map((img) => ({
    url: img.url,
    altText: img.alt ?? page.title,
  })),
];

function formatMoney(amountPence: number, currency: string): string {
  return new Intl.NumberFormat('en-GB', {
    style: 'currency',
    currency,
  }).format(amountPence / 100);
}

// Strip Sanity stega zero-width encoding chars so string comparisons work
// correctly in VariantPicker when Visual Editing is enabled.
function clean(str: string): string {
  return str.replace(/[\u200B-\u200D\uFEFF\u00AD]/g, '');
}

const productOptions: Option[] = (page.options ?? []).map((opt) => ({
  id: clean(opt.name),
  name: clean(opt.name),
  values: opt.values.map((v) => ({ id: clean(v), name: clean(v) })),
}));

const productVariants: Variant[] = (page.variants ?? []).map((v) => ({
  id: v._id,
  name: v.optionValues.map((ov) => clean(ov.value)).join(' / '),
  sku: v.sku,
  price: {
    amount: v.price.amount,
    currency: v.price.currency,
    formatted: formatMoney(v.price.amount, v.price.currency),
  },
  compareAtPrice: v.compareAtPrice
    ? {
        amount: v.compareAtPrice.amount,
        currency: v.compareAtPrice.currency,
        formatted: formatMoney(
          v.compareAtPrice.amount,
          v.compareAtPrice.currency
        ),
      }
    : undefined,
  selectedOptions: Object.fromEntries(
    v.optionValues.map((ov): [string, string] => [
      clean(ov.optionName),
      clean(ov.value),
    ])
  ),
  inventoryStatus: v.inventoryStatus ?? 'out_of_stock',
  weight: v.weight,
}));
---

<Layout
  title={page.title}
  metaTitle={page.metaTitle}
  description={page.metaDescription || page.autoDescription}
  ogImage={page.ogImage || page.autoOgImage}
  previewDoc={{
    _id: page._id,
    _type: page._type,
    _updatedAt: page._updatedAt,
    _originalId: page._originalId,
  }}
>
  <main>
    {
      commerceEnabled && (
        <section class="container py-12 lg:py-16">
          <ProductDetail
            title={page.title}
            description={page.metaDescription}
            images={productImages}
            options={productOptions}
            variants={productVariants}
            selectedVariantId={page.defaultVariant?._id}
            client:load
          />
        </section>
      )
    }

    {
      page.body && page.body.length > 0 && (
        <>
          <SectionDivider />
          <SectionMapper
            sections={page.body}
            instagramHandle={widgets?.instagramHandle}
            beholdFeedId={widgets?.beholdFeedId}
          />
        </>
      )
    }
  </main>
</Layout>
