---
import Layout from '@/layouts/Layout.astro';
---

<Layout
  title="Contact Us — Gather Ground"
  description="Get in touch with Gather Ground farm. We'd love to hear from you."
>
  <main class="container mx-auto max-w-5xl px-4 py-16">
    <div class="mb-12 text-center">
      <h1 class="text-display-md font-bold text-gray-950">Contact Us</h1>
      <p class="mt-4 text-base text-gray-700">
        We'd love to hear from you. Fill out the form below or reach out
        directly.
      </p>
    </div>
    <div class="grid gap-12 lg:grid-cols-2">
      <div>
        <h2 class="mb-6 text-xl font-semibold text-gray-950">
          Send us a message
        </h2>
        <!-- TODO: Import ContactForm from feature/forms-email after merge.
             <ContactForm client:visible /> -->
        <p class="text-sm text-gray-500">Contact form coming soon.</p>
      </div>
      <div>
        <h2 class="mb-6 text-xl font-semibold text-gray-950">Get in touch</h2>
        <div class="flex flex-col gap-4 text-base text-gray-700">
          <!-- TODO: Replace placeholder contact details with actual farm information -->
          <div>
            <p class="font-semibold text-gray-950">Address</p>
            <p>123 Farm Road<br />Rural, Iowa 50001</p>
          </div>
          <div>
            <p class="font-semibold text-gray-950">Email</p>
            <a
              href="mailto:hello@gatherground.com"
              class="text-brand-700 hover:underline"
            >
              hello@gatherground.com
            </a>
          </div>
          <div>
            <p class="font-semibold text-gray-950">Phone</p>
            <!-- TODO: Replace with actual phone number -->
            <a href="tel:+15550000000" class="text-brand-700 hover:underline">
              (555) 000-0000
            </a>
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>
