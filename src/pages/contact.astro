---
import Layout from '@/layouts/Layout.astro';
import SectionMapper from '@/templates/SectionMapper.astro';
import { loadQuery } from '@/lib/sanity';
import { pageBySlugQuery } from '@/lib/queries';

const { data: page } = await loadQuery<{
  _id: string;
  _type: string;
  _updatedAt?: string;
  _originalId?: string;
  title: string;
  slug: string;
  metaTitle?: string;
  metaDescription?: string;
  body: Array<Record<string, unknown> & { _type: string; _key: string }>;
} | null>({
  query: pageBySlugQuery,
  params: { slug: 'contact' },
});
---

<Layout
  title={page?.metaTitle ?? page?.title ?? 'Contact Us — Gather Ground'}
  description={page?.metaDescription ??
    "Get in touch with Gather Ground farm. We'd love to hear from you."}
  previewDoc={page
    ? {
        _id: page._id,
        _type: page._type,
        _updatedAt: page._updatedAt,
        _originalId: page._originalId,
      }
    : undefined}
>
  {
    page ? (
      <SectionMapper sections={page.body} />
    ) : (
      <main class="container py-16">
        <h1 class="text-display-md font-bold text-brand-900">Contact Us</h1>
        <p class="mt-4 text-base text-brand-400">
          We're setting up our contact page. Check back soon!
        </p>
      </main>
    )
  }
</Layout>
