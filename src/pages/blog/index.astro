---
import Layout from '@/layouts/Layout.astro';
import BlogHero from '@/components/BlogHero/BlogHero.astro';
import FeaturedPost from '@/components/FeaturedPost/FeaturedPost.astro';
import PaginatedBlogPosts from '@/components/PaginatedBlogPosts/PaginatedBlogPosts';
import SectionDivider from '@/components/SectionDivider/SectionDivider.astro';
import { loadQuery } from '@/lib/sanity';
import { blogPageQuery, allBlogPostsQuery } from '@/lib/queries';
import { sanityImageSrc, sanityImageAlt } from '@/lib/sanityImage';
import { resolveSanityLink } from '@/lib/sanityLink';

// Fetch blog page hero content — fallback to defaults if not yet created.
const { data: pageContent } = await loadQuery<{
  _id: string;
  _type: string;
  _updatedAt?: string;
  _originalId?: string;
  metaTitle?: string;
  metaDescription?: string;
  heroEyebrow?: string;
  heroHeading?: string;
  heroSubCopy?: string;
  heroPrivacyPolicyLink?: unknown;
} | null>({ query: blogPageQuery });

const heroEyebrow = pageContent?.heroEyebrow ?? 'Blog';
const heroHeading = pageContent?.heroHeading ?? 'Resources and insights';
const heroSubCopy =
  pageContent?.heroSubCopy ??
  'Practical advice from our farm to your table — heritage breeds, seasonal produce, and sustainable farming.';
const heroPrivacyPolicyHref = pageContent?.heroPrivacyPolicyLink
  ? resolveSanityLink(pageContent.heroPrivacyPolicyLink)
  : '/privacy';

// Fetch all blog posts.
const { data: rawPosts } = await loadQuery<
  Array<{
    _id: string;
    title: string;
    slug: string;
    image?: { asset?: { _ref: string }; alt?: string };
    excerpt: string;
    categories?: string[];
    publishedAt?: string;
    author?: {
      name: string;
      avatar?: { asset?: { _ref: string } };
    };
  }>
>({ query: allBlogPostsQuery });

const posts = (rawPosts ?? []).map((post) => {
  const date = post.publishedAt
    ? new Date(post.publishedAt).toLocaleDateString('en-GB', {
        day: 'numeric',
        month: 'short',
        year: 'numeric',
      })
    : '';
  return {
    image: sanityImageSrc(post.image as { asset?: { _ref: string } }, {
      width: 824,
      height: 412,
      quality: 80,
    }),
    imageAlt: sanityImageAlt(post.image, post.title),
    title: post.title,
    excerpt: post.excerpt,
    date,
    authorName: post.author?.name ?? '',
    authorImage: post.author?.avatar
      ? sanityImageSrc(post.author.avatar as { asset?: { _ref: string } }, {
          width: 96,
          height: 96,
          quality: 80,
        })
      : '',
    authorImageAlt: post.author?.name ?? '',
    href: `/blog/${post.slug}`,
    slug: post.slug,
    categories: post.categories ?? [],
  };
});

const [featuredPost, ...gridPosts] = posts;
---

<Layout
  title="Blog"
  metaTitle={pageContent?.metaTitle}
  description={pageContent?.metaDescription || heroSubCopy}
  showRssFeed
  previewDoc={pageContent
    ? {
        _id: pageContent._id,
        _type: pageContent._type,
        _updatedAt: pageContent._updatedAt,
        _originalId: pageContent._originalId,
      }
    : undefined}
>
  <main>
    <BlogHero
      eyebrow={heroEyebrow}
      heading={heroHeading}
      subCopy={heroSubCopy}
      privacyPolicyHref={heroPrivacyPolicyHref}
    />
    {
      featuredPost && (
        <section class="py-16 lg:py-24">
          <div class="container">
            <FeaturedPost
              image={featuredPost.image}
              imageAlt={featuredPost.imageAlt}
              title={featuredPost.title}
              excerpt={featuredPost.excerpt}
              href={featuredPost.href}
              authorName={featuredPost.authorName}
              authorImage={featuredPost.authorImage}
              authorImageAlt={featuredPost.authorImageAlt}
              date={featuredPost.date}
            />
          </div>
        </section>
      )
    }
    <section class="py-16 lg:py-24">
      <div class="container">
        <PaginatedBlogPosts posts={gridPosts} client:load />
      </div>
    </section>
  </main>
</Layout>
