---
import { useStoryblokApi } from '@storyblok/astro';
import type { StoryblokRichTextDocumentNode } from '@storyblok/astro';
import Layout from '@/layouts/Layout.astro';
import PostHeader from '@/components/PostHeader/PostHeader.astro';
import SectionDivider from '@/components/SectionDivider/SectionDivider.astro';
import BlogSection from '@/components/BlogSection/BlogSection.astro';
import { getStoryAuthors } from '@/lib/storyblokAuthors';

export async function getStaticPaths() {
  const storyblokApi = useStoryblokApi();
  const version = import.meta.env.DEV ? 'draft' : 'published';
  const { data } = await storyblokApi.get('cdn/stories', {
    version,
    content_type: 'blog_post',
    per_page: 100,
    excluding_fields: 'content',
  });

  return data.stories.map((story: { slug: string }) => ({
    params: { slug: story.slug },
  }));
}

const { slug } = Astro.params;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin)
  .href;

const storyblokApi = useStoryblokApi();
const version = import.meta.env.DEV ? 'draft' : 'published';

const { data } = await storyblokApi.get(`cdn/stories/blog/${slug}`, {
  version,
});
const post = data.story;

type PostContent = {
  title: string;
  excerpt: string;
  categories?: string[];
  image: { filename: string; alt: string };
  body: StoryblokRichTextDocumentNode;
};

const content = post.content as PostContent;

// Format the story's first_published_at as a human-readable date
const publishedDate = new Date(
  post.first_published_at ?? post.created_at
).toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
});

// Fetch related posts (exclude the current slug)
const { data: relatedData } = await storyblokApi.get('cdn/stories', {
  version,
  content_type: 'blog_post',
  per_page: 4,
  sort_by: 'first_published_at:desc',
  excluding_slugs: slug,
});

const relatedStories = (
  relatedData.stories as Array<{
    id: number;
    full_slug: string;
    first_published_at: string;
    created_at: string;
    content: {
      image: { filename: string; alt: string };
      title: string;
      excerpt: string;
    };
  }>
).slice(0, 3);

// Fetch author info for this post and all related posts in a single MAPI call
const spaceId = import.meta.env.STORYBLOK_SPACE_ID;
const allStoryIds = [post.id, ...relatedStories.map((s) => s.id)];
const authorMap = await getStoryAuthors(spaceId, allStoryIds);
const author = authorMap.get(post.id) ?? { name: '', avatarUrl: '' };

const relatedPosts = relatedStories.map((s) => {
  const a = authorMap.get(s.id) ?? { name: '', avatarUrl: '' };
  const date = new Date(
    s.first_published_at ?? s.created_at
  ).toLocaleDateString('en-GB', {
    day: 'numeric',
    month: 'short',
    year: 'numeric',
  });
  return {
    image: s.content.image?.filename ?? '',
    imageAlt: s.content.image?.alt ?? s.content.title,
    title: s.content.title,
    excerpt: s.content.excerpt,
    date,
    authorName: a.name,
    href: `/${s.full_slug}`,
  };
});
---

<Layout
  title={content.title}
  description={content.excerpt}
  ogImage={content.image.filename}
  ogType="article"
  canonicalUrl={canonicalUrl}
>
  <main>
    <PostHeader
      publishedDate={`Published ${publishedDate}`}
      title={content.title}
      excerpt={content.excerpt}
      categories={content.categories ?? []}
      heroImage={content.image.filename}
      heroImageAlt={content.image.alt || content.title}
      body={content.body}
      authorName={author.name}
      authorAvatar={author.avatarUrl}
      authorAvatarAlt={author.name}
      authorRole=""
    />
    {
      relatedPosts.length > 0 && (
        <>
          <SectionDivider />
          <BlogSection
            eyebrow="From the blog"
            heading="More articles"
            subCopy="More reading from the Gather Ground team."
            viewAllHref="/blog"
            viewAllLabel="View all articles"
            posts={relatedPosts}
          />
        </>
      )
    }
  </main>
</Layout>
