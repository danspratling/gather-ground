---
import Layout from '@/layouts/Layout.astro';
import PostHeader from '@/components/PostHeader/PostHeader.astro';
import SectionDivider from '@/components/SectionDivider/SectionDivider.astro';
import BlogSection from '@/components/BlogSection/BlogSection.astro';
import { loadQuery } from '@/lib/sanity';
import {
  allBlogPostSlugsQuery,
  blogPostBySlugQuery,
  relatedBlogPostsQuery,
} from '@/lib/queries';
import { sanityImageSrc, sanityImageAlt } from '@/lib/sanityImage';
import type { PortableTextBlock } from '@portabletext/types';

export async function getStaticPaths() {
  const { data: posts } = await loadQuery<Array<{ slug: string }>>({
    query: allBlogPostSlugsQuery,
  });
  return posts
    .map((p) => ({ slug: p.slug?.replace(/^\/+/, '') }))
    .filter((p) => !!p.slug)
    .map((p) => ({ params: { slug: p.slug } }));
}

interface SanityImage {
  asset?: { _ref: string };
  alt?: string;
}

interface BlogPost {
  _id: string;
  title: string;
  slug: string;
  image?: SanityImage;
  excerpt: string;
  categories?: string[];
  publishedAt?: string;
  body?: PortableTextBlock[];
  author?: {
    name: string;
    avatar?: SanityImage;
    role?: string;
  };
}

const { slug } = Astro.params;
// Tolerate legacy slugs stored with a leading slash by querying both forms.
const slugVariants = [slug, `/${slug}`];
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin)
  .href;

const { data: post } = await loadQuery<BlogPost | null>({
  query: blogPostBySlugQuery,
  params: { slugVariants },
});

if (!post) {
  return Astro.redirect('/blog');
}

const formatDate = (date: string | undefined) =>
  date
    ? new Date(date).toLocaleDateString('en-GB', {
        day: 'numeric',
        month: 'short',
        year: 'numeric',
      })
    : '';

const publishedDate = formatDate(post.publishedAt);

const { data: relatedRaw } = await loadQuery<BlogPost[]>({
  query: relatedBlogPostsQuery,
  params: { slugVariants },
});

const relatedPosts = (relatedRaw ?? []).map((p) => ({
  image: sanityImageSrc(p.image),
  imageAlt: sanityImageAlt(p.image, p.title),
  title: p.title,
  excerpt: p.excerpt,
  date: formatDate(p.publishedAt),
  authorName: p.author?.name ?? '',
  authorImage: p.author?.avatar ? sanityImageSrc(p.author.avatar) : '',
  authorImageAlt: p.author?.name ?? '',
  href: `/blog/${p.slug?.replace(/^\/+/, '') ?? ''}`,
}));

const heroImage = sanityImageSrc(post.image);
const heroImageAlt = sanityImageAlt(post.image, post.title);
---

<Layout
  title={post.title}
  description={post.excerpt}
  ogImage={heroImage}
  ogType="article"
  canonicalUrl={canonicalUrl}
>
  <main>
    <PostHeader
      publishedDate={publishedDate ? `Published ${publishedDate}` : ''}
      title={post.title}
      excerpt={post.excerpt}
      categories={post.categories ?? []}
      heroImage={heroImage}
      heroImageAlt={heroImageAlt}
      body={post.body ?? []}
      authorName={post.author?.name ?? ''}
      authorAvatar={post.author?.avatar
        ? sanityImageSrc(post.author.avatar)
        : ''}
      authorAvatarAlt={post.author?.name ?? ''}
      authorRole={post.author?.role ?? ''}
    />
    {
      relatedPosts.length > 0 && (
        <>
          <SectionDivider />
          <BlogSection
            eyebrow="From the blog"
            heading="More articles"
            subCopy="More reading from the Gather Ground team."
            viewAllHref="/blog"
            viewAllLabel="View all articles"
            posts={relatedPosts}
          />
        </>
      )
    }
  </main>
</Layout>
