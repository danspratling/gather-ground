---
import Layout from '@/layouts/Layout.astro';
import PostHeader from '@/components/PostHeader/PostHeader.astro';
import SectionDivider from '@/components/SectionDivider/SectionDivider.astro';
import BlogSection from '@/components/BlogSection/BlogSection.astro';
import StructuredData from '@/components/StructuredData/StructuredData.astro';
import { loadQuery } from '@/lib/sanity';
import {
  allBlogPostSlugsQuery,
  blogPostBySlugQuery,
  relatedBlogPostsQuery,
} from '@/lib/queries';
import { sanityImageSrc, sanityImageAlt } from '@/lib/sanityImage';
import { buildBlogPosting } from '@/lib/structuredData';
import type { PortableTextBlock } from '@portabletext/types';

export async function getStaticPaths() {
  const { data: posts } = await loadQuery<Array<{ slug: string }>>({
    query: allBlogPostSlugsQuery,
  });
  return posts.map((p) => ({ params: { slug: p.slug } }));
}

interface SanityImage {
  asset?: { _ref: string };
  alt?: string;
}

interface BlogPost {
  _id: string;
  _type: string;
  _updatedAt?: string;
  _originalId?: string;
  title: string;
  slug: string;
  image?: SanityImage;
  excerpt: string;
  categories?: string[];
  publishedAt?: string;
  body?: PortableTextBlock[];
  metaTitle?: string;
  metaDescription?: string;
  author?: {
    name: string;
    avatar?: SanityImage;
    role?: string;
  };
}

const { slug } = Astro.params;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin)
  .href;

const { data: post } = await loadQuery<BlogPost | null>({
  query: blogPostBySlugQuery,
  params: { slug },
});

if (!post) {
  return Astro.redirect('/blog');
}

const formatDate = (date: string | undefined) =>
  date
    ? new Date(date).toLocaleDateString('en-GB', {
        day: 'numeric',
        month: 'short',
        year: 'numeric',
      })
    : '';

const publishedDate = formatDate(post.publishedAt);

const { data: relatedRaw } = await loadQuery<BlogPost[]>({
  query: relatedBlogPostsQuery,
  params: { slug },
});

const relatedPosts = (relatedRaw ?? []).map((p) => ({
  image: sanityImageSrc(p.image, { width: 600, height: 192, quality: 80 }),
  imageAlt: sanityImageAlt(p.image, p.title),
  title: p.title,
  excerpt: p.excerpt,
  date: formatDate(p.publishedAt),
  authorName: p.author?.name ?? '',
  authorImage: p.author?.avatar
    ? sanityImageSrc(p.author.avatar, { width: 96, height: 96, quality: 80 })
    : '',
  authorImageAlt: p.author?.name ?? '',
  href: `/blog/${p.slug}`,
}));

const heroImage = sanityImageSrc(post.image, {
  width: 1216,
  height: 640,
  quality: 80,
});
const heroImageAlt = sanityImageAlt(post.image, post.title);

const siteUrl = (Astro.site ?? new URL(Astro.url.origin))
  .toString()
  .replace(/\/$/, '');
const blogPostingSD = buildBlogPosting(
  {
    title: post.title,
    description: post.excerpt,
    slug: post.slug,
    publishedAt: post.publishedAt,
    authorName: post.author?.name,
    image: heroImage,
  },
  siteUrl
);
---

<Layout
  title={post.title}
  metaTitle={post.metaTitle}
  description={post.metaDescription || post.excerpt}
  ogImage={heroImage}
  ogType="article"
  canonicalUrl={canonicalUrl}
  previewDoc={{
    _id: post._id,
    _type: post._type,
    _updatedAt: post._updatedAt,
    _originalId: post._originalId,
  }}
>
  <StructuredData data={blogPostingSD} slot="head-extras" />
  <main>
    <PostHeader
      publishedDate={publishedDate ? `Published ${publishedDate}` : ''}
      title={post.title}
      excerpt={post.excerpt}
      categories={post.categories ?? []}
      heroImage={heroImage}
      heroImageAlt={heroImageAlt}
      body={post.body ?? []}
      authorName={post.author?.name ?? ''}
      authorAvatar={post.author?.avatar
        ? sanityImageSrc(post.author.avatar, {
            width: 96,
            height: 96,
            quality: 80,
          })
        : ''}
      authorAvatarAlt={post.author?.name ?? ''}
      authorRole={post.author?.role ?? ''}
    />
    {
      relatedPosts.length > 0 && (
        <>
          <SectionDivider />
          <BlogSection
            eyebrow="From the blog"
            heading="More articles"
            subCopy="More reading from the Gather Ground team."
            viewAllHref="/blog"
            viewAllLabel="View all articles"
            posts={relatedPosts}
          />
        </>
      )
    }
  </main>
</Layout>
