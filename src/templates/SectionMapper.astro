---
/**
 * SectionMapper — replaces StoryblokComponent for Sanity.
 * Maps `_type` to the correct section component.
 *
 * All data normalization lives in `sectionData.ts` so that
 * the template body stays free of TypeScript generics, which
 * the .astro JSX parser treats ambiguously.
 */
import ContactHero from '@/components/ContactHero/ContactHero.astro';
import HeroSection from '@/components/HeroSection/HeroSection.astro';
import InstagramFeedSection from '@/components/InstagramFeedSection/InstagramFeedSection.astro';
import ProductsSection from '@/components/ProductsSection/ProductsSection.astro';
import TestimonialsSection from '@/components/TestimonialsSection/TestimonialsSection';
import FaqSection from '@/components/FaqSection/FaqSection.astro';
import BlogSection from '@/components/BlogSection/BlogSection.astro';
import CallToAction from '@/components/CallToAction/CallToAction.astro';
import Content from '@/components/Content/Content.astro';
import {
  blogSectionProps,
  callToActionProps,
  contactHeroProps,
  contentSectionProps,
  faqSectionProps,
  heroSectionProps,
  instagramFeedSectionProps,
  productsSectionProps,
  resolveAlternatingPositions,
  testimonialsSectionProps,
  type SanitySection,
} from './sectionData';

interface Props {
  sections: SanitySection[];
  /** Instagram handle (no @) from Site Settings — used by instagramFeedSection. */
  instagramHandle?: string;
  /** Behold.so feed ID from Site Settings — used by instagramFeedSection. */
  beholdFeedId?: string;
}

const { sections, instagramHandle, beholdFeedId } = Astro.props;

// Pre-compute resolved left/right placement for every alternating
// contentSection on the page so they auto-flip across the layout.
const alternatingPositions = resolveAlternatingPositions(sections);

const BEHOLD_WIDGET_SCRIPT = 'https://w.behold.so/widget.js';

// Emit the Behold widget script once if any instagramFeedSection on this
// page will render with a feed ID — prevents duplicate script injection
// when multiple Instagram sections appear on the same page.
const needsBeholdScript =
  beholdFeedId != null &&
  sections.some((s) => s._type === 'instagramFeedSection');
---

{
  sections.map((section) => {
    switch (section._type) {
      case 'heroSection':
        return <HeroSection {...heroSectionProps(section)} />;
      case 'productsSection':
        return <ProductsSection {...productsSectionProps(section)} />;
      case 'testimonialsSection':
        return (
          <TestimonialsSection
            client:visible
            {...testimonialsSectionProps(section)}
          />
        );
      case 'faqSection':
        return <FaqSection {...faqSectionProps(section)} />;
      case 'blogSection':
        return <BlogSection {...blogSectionProps(section)} />;
      case 'callToAction':
        return <CallToAction {...callToActionProps(section)} />;
      case 'contactHero':
        return <ContactHero {...contactHeroProps(section)} />;
      case 'instagramFeedSection':
        return (
          <InstagramFeedSection
            {...instagramFeedSectionProps(section, instagramHandle, beholdFeedId)}
          />
        );
      case 'contentSection':
        return (
          <Content
            {...contentSectionProps(
              section,
              alternatingPositions.get(section._key)
            )}
          />
        );
      default:
        console.warn('[SectionMapper] Unknown section type: ' + section._type);
        return null;
    }
  })
}

{needsBeholdScript && <script is:inline type="module" src={BEHOLD_WIDGET_SCRIPT} />}
