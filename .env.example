# Copy this file to .env and fill in the values.
# Never commit .env — it is gitignored.

# Sanity — project config
SANITY_PROJECT_ID=mrz1ftls
SANITY_DATASET=production

# Ecommerce rollout flag (global gate)
# false = hide all ecommerce surfaces (default for Vercel Preview + Production)
# true  = enable ecommerce surfaces (local dev and later rollout stages)
#
# Rollout sequence:
# 1) Kickoff: local=false, preview=false, production=false
# 2) Active development: local=true, preview=false, production=false
# 3) Preview QA (GG-E55-A): local=true, preview=true, production=false
# 4) Production launch (GG-E55-D): local=true, preview=true, production=true
PUBLIC_COMMERCE_ENABLED=false

# Sanity — API read token (Viewer permission, required for draft preview + stega)
# Get from: sanity.io/manage → API → Tokens → Add API token
SANITY_API_READ_TOKEN=

# Sanity — enable Visual Editing overlays + stega-encoded fetches (dev/preview only)
# Visual editing auto-enables in dev and Vercel preview deployments.
# Set to "true" here only if you need to force it on in an environment where
# it wouldn't otherwise activate.
PUBLIC_SANITY_VISUAL_EDITING_ENABLED=false

# Untitled UI Pro — private npm registry
# Run this once locally (stored in your global ~/.npmrc, never committed):
#   npm config set //pkg.untitledui.com/:_authToken=YOUR_TOKEN_HERE
# For CI: add as a GitHub Actions secret named UNTITLEDUI_TOKEN.

# Location map embed URL (Google Maps, OpenStreetMap, etc.)
PUBLIC_MAPS_EMBED_URL=

# Microsoft Clarity project ID
PUBLIC_CLARITY_PROJECT_ID=

# Cloudflare Turnstile (bot protection)
# Get from: dash.cloudflare.com → Turnstile → your site
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Resend — transactional email
# Get from: resend.com → API Keys
RESEND_API_KEY=
# The "from" address for outbound emails (must be a verified domain in Resend)
RESEND_FROM_EMAIL=

# Brevo — email marketing (newsletter subscriptions + contact-form opt-ins)
# Get the API key from: app.brevo.com → SMTP & API → API Keys
BREVO_API_KEY=
# The numeric ID of the Brevo contact list to subscribe people to.
# Find it at: app.brevo.com → Contacts → Lists (ID shown next to each list)
BREVO_NEWSLETTER_LIST_ID=
