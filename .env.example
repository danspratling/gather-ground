# Copy this file to .env and fill in the values.
# Never commit .env — it is gitignored.

# Sanity — project config
SANITY_PROJECT_ID=mrz1ftls
SANITY_DATASET=production

# Ecommerce rollout flag (global gate)
# false = hide all ecommerce surfaces (default for Vercel Preview + Production)
# true  = enable ecommerce surfaces (local dev and later rollout stages)
#
# Rollout sequence:
# 1) Kickoff: local=false, preview=false, production=false
# 2) Active development: local=true, preview=false, production=false
# 3) Preview QA (GG-E55-A): local=true, preview=true, production=false
# 4) Production launch (GG-E55-D): local=true, preview=true, production=true
PUBLIC_COMMERCE_ENABLED=false

# Commerce adapter selector — picks which vendor implementation is used at runtime.
# Defaults to "commercelayer". "shopify" is a stub today and will throw on call.
COMMERCE_PROVIDER=commercelayer

# Commerce Layer — server-side integration credentials (confidential, server-only)
# Get from: dashboard.commercelayer.io → your org → Developers → API credentials
#   → open the Integration application (e.g. "Web application") → copy Client ID + Secret
COMMERCELAYER_ORGANIZATION=gather-ground
COMMERCELAYER_INTEGRATION_CLIENT_ID=
COMMERCELAYER_INTEGRATION_CLIENT_SECRET=

# Commerce Layer — sales channel credentials (public, used for customer auth flow)
# Get from: dashboard.commercelayer.io → your org → Developers → API credentials
#   → open the Sales channel application (e.g. "Checkout") → copy Client ID
COMMERCELAYER_SALES_CHANNEL_CLIENT_ID=

# Commerce Layer — market ID (the UK market for this org)
# Find it at: dashboard.commercelayer.io → your org → Markets → click market → copy ID
# Sandbox value: lqxGhxxGGg
COMMERCELAYER_MARKET_ID=lqxGhxxGGg

# Commerce Layer — webhook signing secret (used to verify inbound webhook payloads)
# Get from: dashboard.commercelayer.io → your org → Developers → Webhooks
#   → create or open a webhook → copy the Signing secret
COMMERCELAYER_WEBHOOK_SECRET=

# Session cookie secret — used by iron-session to sign + encrypt the gg_session cookie.
# Must be at least 32 characters. Generate with: openssl rand -base64 48
SESSION_SECRET=

# Sanity — API read token (Viewer permission, required for draft preview + stega)
# Get from: sanity.io/manage → API → Tokens → Add API token
SANITY_API_READ_TOKEN=

# Sanity — enable Visual Editing overlays + stega-encoded fetches (dev/preview only)
# Visual editing auto-enables in dev and Vercel preview deployments.
# Set to "true" here only if you need to force it on in an environment where
# it wouldn't otherwise activate.
PUBLIC_SANITY_VISUAL_EDITING_ENABLED=false

# Untitled UI Pro — private npm registry
# Run this once locally (stored in your global ~/.npmrc, never committed):
#   npm config set //pkg.untitledui.com/:_authToken=YOUR_TOKEN_HERE
# For CI: add as a GitHub Actions secret named UNTITLEDUI_TOKEN.

# Location map embed URL (Google Maps, OpenStreetMap, etc.)
PUBLIC_MAPS_EMBED_URL=

# Microsoft Clarity project ID
PUBLIC_CLARITY_PROJECT_ID=

# Cloudflare Turnstile (bot protection)
# Get from: dash.cloudflare.com → Turnstile → your site
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Resend — transactional email
# Get from: resend.com → API Keys
RESEND_API_KEY=
# The "from" address for outbound emails (must be a verified domain in Resend)
RESEND_FROM_EMAIL=

# Brevo — email marketing (newsletter subscriptions + contact-form opt-ins)
# Get the API key from: app.brevo.com → SMTP & API → API Keys
BREVO_API_KEY=
# The numeric ID of the Brevo contact list to subscribe people to.
# Find it at: app.brevo.com → Contacts → Lists (ID shown next to each list)
BREVO_NEWSLETTER_LIST_ID=

# Stripe — payment processing
# Get from: dashboard.stripe.com → Developers → API keys
#   Publishable key: starts with pk_test_ (sandbox) or pk_live_ (production)
#   Secret key: use a Restricted key scoped to payment_intents:write only (not the live secret key)
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
