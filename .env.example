# Copy this file to .env and fill in the values.
# Never commit .env — it is gitignored.

# Sanity — project config
SANITY_PROJECT_ID=mrz1ftls
SANITY_DATASET=production

# Sanity — API read token (Viewer permission, required for draft preview + stega)
# Get from: sanity.io/manage → API → Tokens → Add API token
SANITY_API_READ_TOKEN=

# Sanity — enable Visual Editing overlays + stega-encoded fetches (dev/preview only)
# Set to "true" locally to enable click-to-edit in the embedded Studio at /studio.
PUBLIC_SANITY_VISUAL_EDITING_ENABLED=false

# Untitled UI Pro — private npm registry
# Run this once locally (stored in your global ~/.npmrc, never committed):
#   npm config set //pkg.untitledui.com/:_authToken=YOUR_TOKEN_HERE
# For CI: add as a GitHub Actions secret named UNTITLEDUI_TOKEN.

# Location map embed URL (Google Maps, OpenStreetMap, etc.)
PUBLIC_MAPS_EMBED_URL=

# Microsoft Clarity project ID
PUBLIC_CLARITY_PROJECT_ID=

# Cloudflare Turnstile (bot protection)
# Get from: dash.cloudflare.com → Turnstile → your site
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Resend — transactional email
# Get from: resend.com → API Keys
RESEND_API_KEY=
# The "from" address for outbound emails (must be a verified domain in Resend)
RESEND_FROM_EMAIL=
