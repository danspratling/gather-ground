# Copy this file to .env and fill in the values.
# Never commit .env — it is gitignored.

# Storyblok — server-side content delivery
STORYBLOK_TOKEN=
STORYBLOK_SPACE_ID=289911665285843

# Storyblok — client-side visual editor bridge (preview mode only)
PUBLIC_STORYBLOK_TOKEN=

# Storyblok — personal access token for CLI schema sync (Management API)
# Get from: app.storyblok.com → My Account → Personal Access Tokens
# Required to run: npm run sync-schemas
STORYBLOK_PERSONAL_TOKEN=

# Sanity — project config
SANITY_PROJECT_ID=mrz1ftls
SANITY_DATASET=production

# Sanity — API read token (Viewer permission)
# Get from: sanity.io/manage → API → Tokens → Add API token
SANITY_API_READ_TOKEN=

# Sanity — enable Visual Editing overlays (dev/preview only)
PUBLIC_SANITY_VISUAL_EDITING_ENABLED=false

# Untitled UI Pro — private npm registry
# Run this once locally (stored in your global ~/.npmrc, never committed):
#   npm config set //pkg.untitledui.com/:_authToken=YOUR_TOKEN_HERE
# For CI: add as a GitHub Actions secret named UNTITLEDUI_TOKEN.
